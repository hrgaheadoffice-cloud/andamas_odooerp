<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="cogs_management_name_view_form" model="ir.ui.view">
            <field name="name">cogs.management.view.form</field>
            <field name="model">cogs.management</field>
            <field name="arch" type="xml">
                <form >
                <header>
                        <button
                        name="action_post"
                        type="object"
                        states="draft"
                        string="Post"
                        class="oe_highlight"
                    />
                    <field name="state" widget="statusbar" />

                </header>
                    <sheet>
                    <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1" force_save="1"/>
                            </h1>
                        </div>
                        <group>
                            <group >
                                <field name="document_date" />
                                <field name="account_move_id" string="Entry" readonly="1" force_save="1"/>
                                <field name="journal_id" options="{'no_create': True}"/>
                                <field name="project_code_id" required="1"/>
                                <field name="vessel_code" />
                                <field name="customer_code" />
                                <field name="term_shipment" />
                                <field name="contract_number" />
                                <field name="qty" readonly="1" force_save="1" />
                                <field name="revenue" readonly="1" force_save="1"/>
                                <field name="exchange_rate" readonly="1" force_save="1"/>
                                
                            </group>
                            <group >
                                <field name="main_currency_id"  invisible="1"/>
                                <field name="currency_id" />
                                <field name="company_id" />
                                
                            </group>

                            
                            
                            
                        </group>
                        <notebook>
                                <page name="wip_detail" string="WIP Details">
                                    <field name="wip_detail_ids" readonly="1" force_save="1">
                                        <tree create="0" edit="0" delete="0">
                                            <field name="account_id" />
                                            <field name="amount" sum="Total Amount"/>
                                        </tree>
                                    
                                    </field>
                                    
                                </page>

                            <page string="Journal Items" name="jurnal_ids">
                                <field name="journal_ids"  readonly="1" context="{'default_partner_id': customer_code,'default_company_id': company_id}">
                                    <tree editable="bottom">
                                        <field name="account_id" domain="[('deprecated', '=', False),('company_id', '=', parent.company_id),('is_off_balance', '=', False)]"/>
                                        <field name="name"/>
                                        <field name="company_id" invisible="1"/>
                                        <!-- <field name="project_code"/> -->
                                        <!-- <field name="currency_id"/> -->
                                        <field name="debit"/>
                                        <field name="credit"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="P&amp;L Project" name="pl_project">
                                    <group >
                                        <group >
                                            <field name="price_mt" string="Price / MT (IDR)" readonly="1" force_save="1"/>
                                            <field name="qty" string="Tonage (MT)" readonly="1" force_save="1"/>
                                            <field name="revenue_idr" readonly="1" force_save="1" string="Revenue"/>
                                        </group>

                                        
                                        
                                    </group>

                                    <group >
                                        <group string="COS">
                                            
                                             <field name="hauling_stockpille" string="Haulling Stockpile" readonly="1" force_save="1"/>
                                            <field name="terminal_handling" string="Terminal Handling" readonly="1" force_save="1"/>
                                            <field name="haulling_36_port" string="Haulling Coal Transfer" readonly="1" force_save="1"/>
                                            <field name="barging" string="Barging" readonly="1" force_save="1"/>
                                            <field name="floating_crane" string="Floating Crane" readonly="1" force_save="1"/>
                                            <field name="surveyor" string="Surveyor Analysis" readonly="1" force_save="1"/>
                                            <field name="stevedooring" string="Stevedooring" readonly="1" force_save="1"/>
                                            <field name="coal_lcv" string="Coal Purchase LCV" readonly="1" force_save="1"/>
                                            <field name="coal_mcv" string="Coal Purchase MCV" readonly="1" force_save="1"/>
                                            <field name="coal_hcv" string="Coal Purchase HCV" readonly="1" force_save="1"/>
                                            <field name="consultant" string="Consultant" readonly="1" force_save="1"/>
                                            <field name="cos_total" string="Total" readonly="1" force_save="1"/>
                                            
                                            
                                        </group>

                                       
                                        
                                    </group>

                                    <group >
                                         <group >
                                            <field name="cos_mt" string="COS / MT" readonly="1" force_save="1"/>
                                            <field name="gross_margin" string="Gross Margin" readonly="1" force_save="1"/>
                                            <field name="percent" string="%" readonly="1" force_save="1"/>
                                            <field name="margin_mt" string="Margin M/T" readonly="1" force_save="1"/>
                                            
                                        </group>
                                        
                                    </group>
                            </page>

                            </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids"/>

                    </div>
                </form>
            </field>
        </record>


        <record id="cogs_management_name_view_tree" model="ir.ui.view">
            <field name="name">cogs.management.view.tree</field>
            <field name="model">cogs.management</field>
            <field name="arch" type="xml">
                <tree string="">
                    <!-- <field name="name" /> -->
                    <field name="document_date" />
                    <field name="project_code_id" attrs="{'readonly':[('state','!=','draft')]}"/>
                    <!-- <field name="account_move_id" /> -->
                    <field name="customer_code" />
                    <field name="revenue_idr" string="Revenue"/>
                    <field name="wip_total" string="WIP Amount"/>
                    <field name="cogs_amount" />
                    <field name="gross_margin" />
                    <field name="state" />
                    <field name="currency_id" invisible="1" />
                    <field name="main_currency_id" invisible="1" />
                    
                </tree>
            </field>
        </record>

        <record id="cogs_management_name_action" model="ir.actions.act_window">
            <field name="name">COGS Management</field>
            <field name="res_model">cogs.management</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>


        <menuitem
            id="cogs_management_menu"
            name="COGS Management"
            web_icon="cogs_management,static/description/icon.png"
            sequence="20"/>

        <menuitem
            id="cogs_menu"
            name="COGS Management"
            action="cogs_management_name_action"
            parent="cogs_management_menu"
            sequence="10"/>
    
        
    
    </data>
    

</odoo>
