<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <template id="custom_layout">
            <t t-if="not o" t-set="o" t-value="doc"/>

            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
           <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
               <div class="row">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 150px;
                        margin-left: 355px; margin-bottom: 5px;"
                         alt="Logo"/>
               </div>
               <div class="row">
                    <div class="col-8 mb4">
                        <style>
                            h3 {
<!--                                color: #189ad3;-->
                                font-weight: bold;
                            }
                        </style>
                        <h5 t-if="report_type == 'wo'">WORK ORDER MECHANIC MTCE</h5>

                        <h1 t-if="report_type == 'requisition_printout'">REQUISITION</h1>
                        <h1 t-if="report_type == 'pr'">PURCHASE REQUEST</h1>
                        <h1 t-if="report_type == 'rfq'">REQUEST FOR QUOTATION</h1>
                        <h1 t-if="report_type == 'cm'">CARGO MANIFEST</h1>
                        <h1 t-if="report_type == 'fleet_rent'">CUSTOMER RENT</h1>
                        <h1 t-if="report_type == 'invoice'">CUSTOMER INVOICE</h1>
                        <h1 t-if="report_type == 'bill'">VENDOR BILL</h1>
                        <h1 t-if="report_type == 'proforma'">PROFORMA INVOICE</h1>
                        <h1 t-if="report_type == 'trasporter_task'">TRANSPORTER TASK</h1>
                        <h1 t-if="report_type == 'good_issue'">GOOD ISSUE</h1>
                        <span t-if="report_type == 'good_issue'">(Pengeluaran Barang)</span>
                        <h3 t-field="doc.name"/>
<!--                        <span t-if="report_type in ['pr', 'wo', 'cm', 'trasporter_task']">Confirmation Date : </span>-->
                        <span t-if="report_type in ['good_issue']">Date : </span>
                        <span t-if="report_type in ['good_issue']" t-field="doc.scheduled_date"/>
                        <span t-if="report_type in ['invoice', 'bill']">Invoice Date : </span>
                        <span t-if="report_type in ['invoice', 'bill']" t-field="doc.invoice_date"/>
                        <span t-if="report_type == 'pr'" t-field="doc.requested_dt"/>
<!--                        <span t-if="report_type == 'wo'" t-field="doc.start_date"/>-->
                        <span t-if="report_type == 'cm'" t-field="doc.reg_date"/>
                        <span t-if="report_type == 'trasporter_task'" t-field="doc.date"/>
<!--                        <div style="font-size: 12px !important;" class="oe_inline" t-field="company.partner_id"-->
<!--                             t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'-->
<!--                        />-->
                    </div>
                </div>
           </div>
            <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout"  t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-raw="0"/>
            </div>

        </template>
<!--                A5 paper format-->
        <record id="paperformat_a5" model="report.paperformat">
            <field name="name">A5</field>
            <field name="default" eval="True"/>
            <field name="format">A5</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">50</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">65</field>
            <field name="dpi">90</field>
        </record>
    </data>
</odoo>