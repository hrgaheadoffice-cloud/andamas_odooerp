<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <record id="custom_manufacturing_order_form_view" model="ir.ui.view">
           <field name="name">custom_manufacturing_order_form_view</field>
           <field name="model">mrp.production</field>
           <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
           <field name="arch" type="xml">

               <xpath expr="//notebook" position="inside">
                   <page string="Services">
                       <group>
                           <group>
                               <button name="action_create_purchase_request" class="oe_highlight" type="object" string="Create PR"/>
                           </group>
                       </group>
                   </page>
               </xpath>

           </field>
       </record>
    </data>
</odoo>