<?xml version="1.0"?>
<odoo>
    <record id="delay_factor_tree" model="ir.ui.view">
        <field name="name">delay.factor.tree</field>
        <field name="model">delay.factor</field>
        <field name="arch" type="xml">
            <tree string="Delay Factor">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="delay_factor_form" model="ir.ui.view">
        <field name="name">delay.factor.form</field>
        <field name="model">delay.factor</field>
        <field name="arch" type="xml">
           <form>
               <sheet>
                   <group>
                       <field name="name"/>
                   </group>
               </sheet>
           </form>
        </field>
    </record>

    <record id="action_delay_factor" model="ir.actions.act_window">
        <field name="name">Delay Factor</field>
        <field name="res_model">delay.factor</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Delay Factor" id="menu_delay_factor" action="action_delay_factor" parent="menu_mnt_master_data"  sequence="45"/>
</odoo>