<?xml version="1.0" encoding='UTF-8'?>
<odoo>
    <record id="work_summary_tree" model="ir.ui.view">
        <field name="name">work.summary.tree</field>
        <field name="model">work.summary</field>
        <field name="arch" type="xml">
            <tree string="Work summary" create="1">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="maintenance_type"/>
                <field name="date"/>
                <field name="work_order_rfu"/>
                <field name="state" optional="show" decoration-info="state == 'draft'" decoration-warning="state in ['confirm']" decoration-success="state in ['done']" decoration-bf="state == 'progress'" decoration-danger="state == 'cancel'" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="work_summary_form" model="ir.ui.view">
        <field name="name">work_summary_form</field>
        <field name="model">work.summary</field>
        <field name="arch" type="xml">
            <form string="Work summary">
                <header>
                    <button type="object" name="action_submit" string="Submit" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button type="object" name="action_cancel" string="Cancel" attrs="{'invisible': [('state', 'in', ['submit','cancel'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submit"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label"> No Work summary </span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <form>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="equipment_id"/>
                                <field name="maintenance_type"/>
                                <field name="date"/>
                                <field name="work_order_rfu"/>
                            </group>
                        </group>
                    </form>
                </sheet>
            </form>
        </field>
    </record>

