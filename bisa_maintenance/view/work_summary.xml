    <record id="action_work_summary" model="ir.actions.act_window">
        <field name="name">Work summary</field>
        <field name="res_model">work.summary</field>
        <field name="view_mode">tree,form</field>
<!--        <field name="search_view_id" ref="view_work_summary_search"/>-->
    </record>

    <menuitem name="Work Summary" id="menu_work_summary" action="action_work_summary" parent="menu_mnt_operation_top"  sequence="15"/>

</odoo>