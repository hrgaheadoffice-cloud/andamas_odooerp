<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model='ir.ui.view' id='view_tyre_removal_tree'>
        <field name="name">view.tyre.removal.tree</field>
        <field name="model">tyre.removal</field>
        <field name="arch" type="xml">
            <tree string="Tyre Removal" create="0">
                <field name="date"/>
                <field name="equipment_id"/>
                <field name="pos"/>
                <field name="serial_number"/>
                <field name="km_running"/>
                <field name="product_id"/>
                <field name="rtd_percentage"/>
                <field name="tur"/>
                <field name="remove_price"/>
            </tree>
        </field>
    </record>

    <record model='ir.ui.view' id='view_tyre_removal_form'>
        <field name="name">view.tyre.removal.form</field>
        <field name="model">tyre.removal</field>
        <field name="arch" type="xml">
            <form string="Tyre Removal" create="0">
                <sheet>
                    <group>
                        <group string="Tyre Detail">
                            <field name="pos"/>
                            <field name="size"/>
                            <field name="serial_number"/>
                            <field name="km_running"/>
                            <field name="product_id"/>
                            <field name="product_price"/>
                            <field name="pattern"/>
                            <field name="problem"/>
                            <field name="remarks"/>
                        </group>
                        <group string="Tyre Condition">
                            <field name="otd"/>
                            <field name="rtd"/>
                            <field name="rtd_2"/>
                            <field name="rtd_average"/>
                            <field name="rtd_percentage"/>
                            <field name="tur"/>
                            <field name="pressure_hc"/>
                            <field name="pressure_hp"/>
                            <field name="remove_price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action view for Vehicles Rent -->
    <record id="action_tyre_removal_view" model="ir.actions.act_window">
        <field name="name">Tyre Removal Line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tyre.removal</field>
    </record>

<!--    <menuitem name="Tire Reporting" id="menu_tyre_removal" parent="menu_mnt_matrial_top" action="action_tyre_removal_view" sequence="30"/>-->
</odoo>
