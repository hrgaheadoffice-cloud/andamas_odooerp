<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model='ir.ui.view' id='view_tyre_problem_tree'>
        <field name="name">view.tyre.problem.tree</field>
        <field name="model">tyre.problem</field>
        <field name="arch" type="xml">
            <tree string="Tyre Problem">
                <field name="name"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record model='ir.ui.view' id='view_tyre_problem_form'>
        <field name="name">view.tyre.problem.form</field>
        <field name="model">tyre.problem</field>
        <field name="arch" type="xml">
            <form string="Tyre Problem">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action view for Vehicles Rent -->
    <record id="action_tyre_problem_view" model="ir.actions.act_window">
        <field name="name">Tyre Problem</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tyre.problem</field>
    </record>

    <menuitem name="Tyre Problem" id="menu_tyre_problem" parent="menu_mnt_master_data" action="action_tyre_problem_view" sequence="50"/>
</odoo>
