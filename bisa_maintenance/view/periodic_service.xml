<?xml version="1.0" encoding='UTF-8'?>

<odoo>
    <record id="periodic_service_tree" model="ir.ui.view">
        <field name="name">periodic.service.tree</field>
        <field name="model">periodic.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="maintenance_type"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="meter_type"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="periodic_service_form" model="ir.ui.view">
        <field name="name">periodic.service.form</field>
        <field name="model">periodic.service</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="action_submit" string="Submit" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button type="object" name="action_compute" string="Compute" class="oe_highlight" confirm="This will add data line for periodic service cycle, do you want to continue?" attrs="{'invisible': [('state', '!=', 'submit')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submit"/>
                </header>
                <sheet>
                    <form>
                        <group>
                            <group string="Schedule Info">
                                <field name="company_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="maintenance_type" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="brand" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="model" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="meter_type" attrs="{'readonly': [('state', '!=', 'draft')]}" required="1"/>
                            </group>
                            <group string="Period Info">
                                <field name="periodic_service" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="periodic_service_2" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="periodic_service_3" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="periodic_service_4" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="periodic_service_5" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string='Periodic Service 1'>
                                <field name="periodic_service_detail_ids" readonly="1">
                                    <tree editable="bottom">
                                        <field name="periodic_service_id" invisible="1"/>
                                        <field name="cycle"/>
                                        <field name="limit_minimum"/>
                                        <field name="limit_maximum"/>
                                    </tree>
                                </field>
                            </page>
                            <page string='Periodic Service 2'>
                                <field name="periodic_service_detail_2_ids" readonly="1">
                                    <tree editable="bottom">
                                        <field name="periodic_service_id" invisible="1"/>
                                        <field name="cycle"/>
                                        <field name="limit_minimum"/>
                                        <field name="limit_maximum"/>
                                    </tree>
                                </field>
                            </page>
                            <page string='Periodic Service 3'>
                                <field name="periodic_service_detail_3_ids" readonly="1">
                                    <tree editable="bottom">
                                        <field name="periodic_service_id" invisible="1"/>
                                        <field name="cycle"/>
                                        <field name="limit_minimum"/>
                                        <field name="limit_maximum"/>
                                    </tree>
                                </field>
                            </page>
                            <page string='Periodic Service 4'>
                                <field name="periodic_service_detail_4_ids" readonly="1">
                                    <tree editable="bottom">
                                        <field name="periodic_service_id" invisible="1"/>
                                        <field name="cycle"/>
                                        <field name="limit_minimum"/>
                                        <field name="limit_maximum"/>
                                    </tree>
                                </field>
                            </page>
                            <page string='Periodic Service 5'>
                                <field name="periodic_service_detail_5_ids" readonly="1">
                                    <tree editable="bottom">
                                        <field name="periodic_service_id" invisible="1"/>
                                        <field name="cycle"/>
                                        <field name="limit_minimum"/>
                                        <field name="limit_maximum"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </form>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_periodic_service" model="ir.actions.act_window">
        <field name="name">Periodic Service</field>
        <field name="res_model">periodic.service</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Periodic Service" id="menu_periodic_service" action="action_periodic_service" parent="menu_mnt_master_data" sequence="30"/>

    <record model="ir.actions.server" id="action_compute_periodic_service">
       <field name="name">Calculate</field>
       <field name="model_id" ref="bisa_maintenance.model_periodic_service"/>
       <field name="binding_model_id" ref="bisa_maintenance.model_periodic_service"/>
       <field name="state">code</field>
       <field name="code">
           action = records.action_compute()
       </field>
   </record>
</odoo>
