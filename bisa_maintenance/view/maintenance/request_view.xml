	<record id="action_mnt_workorder" model="ir.actions.act_window">
		<field name="name">Work Order</field>
		<field name="res_model">tbl_mnt_request</field>
		<field name="view_mode">tree,form</field>
		<field name="domain">[('status', 'in', ('submit','on_progress','pending','done'))]</field>
	</record> 

