<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model='ir.ui.view' id='view_tyre_fitment_tree'>
        <field name="name">view.tyre.fitment.tree</field>
        <field name="model">tyre.fitment</field>
        <field name="arch" type="xml">
            <tree string="Tyre Fitment" create="0">
                <field name="date"/>
                <field name="equipment_id"/>
                <field name="pos"/>
                <field name="serial_number"/>
                <field name="product_id"/>
                <field name="rtd_percentage"/>
                <field name="tur"/>
                <field name="install_price"/>
            </tree>
        </field>
    </record>

    <record model='ir.ui.view' id='view_tyre_fitment_form'>
        <field name="name">view.tyre.fitment.form</field>
        <field name="model">tyre.fitment</field>
        <field name="arch" type="xml">
            <form string="Tyre Fitment" create="0">
                <sheet>
                    <group>
                        <group string="Tyre Detail">
                            <field name="pos"/>
                            <field name="size"/>
                            <field name="serial_number"/>
                            <field name="km_running"/>
                            <field name="product_id"/>
                            <field name="product_price"/>
                            <field name="pattern"/>
                            <field name="tyre_type"/>
                            <field name="remarks"/>
                        </group>
                        <group string="Tyre Condition">
                             <field name="otd"/>
                            <field name="rtd"/>
                            <field name="rtd_2"/>
                            <field name="rtd_average"/>
                            <field name="rtd_percentage"/>
                            <field name="tur"/>
                            <field name="pressure_hc"/>
                            <field name="pressure_hp"/>
                            <field name="install_price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action view for Vehicles Rent -->
    <record id="action_tyre_fitment_view" model="ir.actions.act_window">
        <field name="name">Tyre Fitment Line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tyre.fitment</field>
    </record>

<!--    <menuitem name="Tire Rotation Report" id="menu_tyre_fitment" parent="menu_mnt_matrial_top" action="action_tyre_fitment_view" sequence="40"/>-->
</odoo>
