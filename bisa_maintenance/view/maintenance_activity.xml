<?xml version="1.0"?>
<odoo>
    <record id="maintenance_activity_tree" model="ir.ui.view">
        <field name="name">maintenance.activity.tree</field>
        <field name="model">maintenance.activity</field>
        <field name="arch" type="xml">
            <tree string="Maintenance Activity">
                <field name="name"/>
                <field name="service_type"/>
                <field name="model"/>
                <field name="brand"/>
                <field name="cycle"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="maintenance_activity_form" model="ir.ui.view">
        <field name="name">maintenance.activity.form</field>
        <field name="model">maintenance.activity</field>
        <field name="arch" type="xml">
           <form>
               <sheet>
                   <div class="oe_title">
                        <span class="o_form_label"> Name </span>
                        <h1>
                            <field name="name" readonly="1" force_save="1"/>
                        </h1>
                    </div>
                   <group>
                        <field name="service_type"/>
                       <field name="brand"/>
                       <field name="model" domain="[('brand', '=', brand)]"/>
                        <field name="cycle"/>
                        <field name="company_id"/>
                   </group>
                   <notebook>
                           <page string="Asset List">
                                <field name="asset_list">
                                    <tree editable="bottom">
                                        <field name="unit_code" />
                                        <field name="asset_name" />
                                    </tree>
                                </field>
                            </page>
						<page string="Part Consumption">
                            <field name="sparepart_ids">
                                <tree editable="bottom">
                                    <field name="product_id" context="{'display_product_code': True}" string="Product Code"/>
                                    <field name="item_desc"/>
                                    <field name="remark"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                </tree>
                            </field>
						</page>
                   </notebook>
               </sheet>
           </form>
        </field>
    </record>

    <record id="maintenance_activity_sparepart_form_view" model="ir.ui.view">
        <field name="name">maintenance.activity.sparepart.form.view</field>
        <field name="model">maintenance.activity.sparepart</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="component"/>
                            <field name="product_id" string="Part Name" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="location_id" domain="[('usage', '=', 'internal')]" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="location_dest_id" domain="[('usage', '=', 'customer')]" options="{'no_create': True,'no_quick_create': True,'no_create_edit': True}"/>
                            <field name="product_uom_qty" string="To Consume"/>
                            <field name="coa"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_maintenance_activity" model="ir.actions.act_window">
        <field name="name">Maintenance Activity</field>
        <field name="res_model">maintenance.activity</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Maintenance Activity" id="menu_maintenance_activity" action="action_maintenance_activity" parent="menu_mnt_master_data"  sequence="35"/>
</odoo>