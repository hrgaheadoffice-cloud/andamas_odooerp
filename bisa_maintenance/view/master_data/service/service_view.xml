<odoo>

	<record id="maintenance_master_service_tree" model="ir.ui.view">
		<field name="name">maintenance_master_service.tree</field>
		<field name="model">maintenance_master_service</field>
		<field name="arch" type="xml">
			<tree>
				<!-- <field name="template_id"/> -->
				<field name="nama"/>
				<field name="unit"/>
				<field name="cycle"/>
				<field name="service_type"/>
			</tree>
		</field>
	</record>

	<record id="maintenance_master_service_form" model="ir.ui.view">
		<field name="name">maintenance_master_service.form</field>
		<field name="model">maintenance_master_service</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group>
						<group>
							<!-- <field name="template_id"/> -->
							<field name="nama"/>
							<field name="unit"/>
						</group>
						<group>
							<field name="cycle"/>
							<field name="service_type"/>
						</group>
					</group>
					<notebook>
						<page name="sparepart" string="List Sparepart">
						</page>
						<page name="jasa" string="List Jasa">
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_maintenance_master_service" model="ir.actions.act_window">
		<field name="name">Maintenance Master Service</field>
		<field name="res_model">maintenance_master_service</field>
		<field name="view_mode">tree,form</field>
		<field name="help" type="html">
			<p class="oe_view_nocontent_smile">
				Hello!
			</p>
			<p>Belum ada tampilan apa pun disini</p>
		</field>
	</record>

</odoo>