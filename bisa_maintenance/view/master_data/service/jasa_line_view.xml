<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="maintenance_jasa_line_form" model="ir.ui.view">
			<field name="name">maintenance_jasa_line.form</field>
			<field name="model">maintenance_master_service</field>
			<field name="inherit_id" ref="bisa_maintenance.maintenance_master_service_form"/>
			<field name="arch" type="xml">
				<xpath expr="//page[@name='jasa']" position="replace">
					<page name="jasa_line" string="List Jasa">
						<field name="jasa_line_ids">
							<tree>
								<field name="produk"/>
								<field name="uom"/>
								<field name="quantity"/>
							</tree>
							<form>
								<group>
									<group>
										<field name="produk"/>
										<field name="uom"/>
									</group>
									<group>
										<field name="quantity"/>
									</group>
								</group>
							</form>
						</field>
					</page>
				</xpath>
			</field>
		</record>
	</data>
</odoo>