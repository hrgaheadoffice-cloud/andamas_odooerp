						<page string="Timesheet History">
							<field name="timesheet_equipment_ids">
								<tree default_order="id desc">
									<field name="tanggal"/>
									<field name="shift"/>
									<field name="hm_awal" string="Start HM"/>
									<field name="hm_akhir" string="End HM"/>
									<field name="ewh"/>
								</tree>
							</field>
						</page>
