								<tree editable="bottom">
									<field name="wr_date" string ="Date &amp; Time"/>
									<field name="name" string ="No. Work Order"/>
									<field name="location_problem" string ="Location"/>
									<field name="description" string ="Description"/>
<!--									<field name="status" decoration-success="status == 'done'" decoration-warning = "status == 'pending'" decoration-primary="status == 'on_progress'" decoration-muted = "status == 'draft'" widget="badge"/>-->
