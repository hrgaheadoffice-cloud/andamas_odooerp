<?xml version="1.0" encoding='UTF-8'?>
<odoo>

	<record id="master_asset_search_view" model="ir.ui.view">
	   <field name="name">master.asset.search.view</field>
	   <field name="model">master_asset_maintenance</field>
	    <field name="arch" type="xml">
	        <search string="Master Asset Maintenance">
				<field name="nama_asset"/>
				<field name="kat_asset"/>
				<field name="plat_no"/>
				<field name="driver"/>
				<group expand='0' string='Group by...'>
                    <filter string='Used to' name="group_by_used_to" context="{'group_by': 'used_to'}"/>
				</group>
			</search>
	   </field>
	</record>
	<record id="master_asset_mt_tree" model="ir.ui.view">
		<field name="name">tree.master_asset_maintenance</field>
		<field name="model">master_asset_maintenance</field>
		<field name="arch" type="xml">
			<tree string="Asset Maintenance">
				<field name="company_id" invisible="1"/>
				<field name="kat_asset"/>
<!--				<field name="no_asset"/>-->
				<field name="nama_asset"/>
<!--				<field name="plat_no"/>-->
				<field name="brand"/>
				<field name="model"/>
<!--				<field name="tahun_buat"/>-->
				<field name="lokasi"/>
				<field name="company_id"/>
				<field name="state"/>
<!--				<field name="nama_vendor"/>-->
			</tree>
		</field>
	</record>

	<record id="master_asset_mt_form" model="ir.ui.view">
		<field name="name">form.master_asset_maintenance</field>
		<field name="model">master_asset_maintenance</field>
		<field name="arch" type="xml">
			<form string="Asset Maintenance">
				<header>
					<button name="action_submit" type="object" string="Submit" states="draft" class="oe_highlight"/>
					<button name="action_standby" type="object" string="Standby" states="running" class="oe_highlight"/>
					<button name="action_disposal" type="object" string="Disposal" states="running"/>
					<button name="action_running" type="object" string='Running' attrs="{'invisible': [('state', 'not in', ('service','standby'))]}" class="oe_highlight"/>
					<field name="state" widget="statusbar" statusbar_visible='draft,running,service,standby,broken'/>
				</header>
				<sheet>
					<group>
						<group string="Asset Information">
							<field name="company_id"/>
							<field name="kat_asset" required="1"/>
							<field name="equipment_id" string="Equipment ID" attrs="{'readonly': [('state', '=', 'running')]}" required="1"/>
							<field name="nama_asset" required="1"/>
							<field name="acc_asset_id"/>
							<field name="own_status"/>
							<field name="nama_vendor" attrs="{'invisible': [('own_status', '!=', 'Rental')]}"/>
							<field name="plat_no"/>
							<field name="tgl_beli"/>
							<field name="harga_beli"/>
							<field name="tahun_buat" required="1"/>
							<field name="lokasi" required="1" options='{"no_open": True, "no_create": True}'/>
						</group>
						<group string="Asset Specification">
							<field name="brand" options='{"no_open": True, "no_create": True}' required="1"/>
							<field name="model" options='{"no_open": True, "no_create": True}' required="1"/>
							<field name="no_mesin"/>
							<field name="no_rangka"/>
							<field name="category" required="1" options='{"no_open": True, "no_create": True}'/>
							<field name="category_class" required="1"/>
							<field name="plotting_location" required="1" options='{"no_open": True, "no_create": True}'/>
							<field name="plotting_function" required="1"/>
							<field name="meter_type"/>
							<field name="kmhm_running"/>
							<field name="bd_date" invisible="1"/>
							<field name="problem" invisible="1"/>
<!--                            <label for="hm" string="HM/KM"/>-->
<!--                            <div class="o_row" name="lasthmkm">-->
<!--                                <field name="hm" placeholder="Last HM ..." attrs="{'readonly': [('state', '!=', 'draft')]}"/> /-->
<!--                                <field name="km" placeholder="Last KM ..." attrs="{'readonly': [('state', '!=', 'draft')]}"/>-->
<!--                            </div>-->
