<!--							<field name="product_tmpl_id" context="{'default_type':'service','default_purchase_ok':False}" string="Rental Service" attrs="{'invisible':[('used_to','!=','rental')]}"/>-->
						</group>
					</group>
					<notebook>
						<page string="Document">
							<field name="document_lines">
								<tree editable="bottom">
									<field name="name"/>
									<field name="attachment_ids" widget="many2many_binary"/>
								</tree>
							</field>
						</page>
<!--						history_transporter_lines -->

						<page string="History Maintenance">
