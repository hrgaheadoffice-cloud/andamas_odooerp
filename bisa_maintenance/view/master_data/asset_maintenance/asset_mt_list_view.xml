	<record id="action_master_asset_maintenance" model="ir.actions.act_window">
		<field name="name">Master Asset Maintenance</field>
		<field name="res_model">master_asset_maintenance</field>
		<field name="view_mode">tree,form</field>
		<!-- <field name="view_id" ref="bisa_maintenance.master_asset_mt_form"/> -->
	</record>

	<record id="master_asset_mt_tree_view" model="ir.actions.act_window.view">
		<field name="sequence" eval="1"/>
		<field name="view_mode">tree</field>
		<field name="view_id" ref="master_asset_mt_tree"/>
		<field name="act_window_id" ref="action_master_asset_maintenance"/>
	</record>

	<record id="master_asset_mt_form_view" model="ir.actions.act_window.view">
		<field name="sequence" eval="2"/>
		<field name="view_mode">form</field>
		<field name="view_id" ref="master_asset_mt_form"/>
		<field name="act_window_id" ref="action_master_asset_maintenance"/>
	</record>

	<menuitem name="Asset Manajemen" id="menu_master_asset_manajemen" parent="menu_mnt_master_data" action="action_master_asset_maintenance" sequence="25"/>




	 <record id="tbl_aset_lokasi_form" model="ir.ui.view">
        <field name="name">form.tbl_aset.lokasi</field>
        <field name="model">tbl_aset_lokasi</field>
        <field name="arch" type="xml">
            <form string="Lokasi Aset">
              <sheet>
                <group>
					<field name="name"/>
                </group>
              </sheet>
            </form>
        </field>
</record>

<record id="tbl_aset_lokasi_tree" model="ir.ui.view">
    <field name="name">tree.tbl_aset_lokasi</field>
    <field name="model">tbl_aset_lokasi</field>
    <field name="arch" type="xml">
        <tree string="Lokasi Aset">
			<field name="name"/>
			<field name="company_id"/>
        </tree>
    </field>
</record>

<record id="action_aset_lokasi" model="ir.actions.act_window">
    <field name="name">Aset Lokasi</field>
    <field name="res_model">tbl_aset_lokasi</field>
    <field name="view_mode">tree,form</field>
</record> 

<menuitem name="Asset Location" id="menu_aset_lokasi_left" action="action_aset_lokasi" parent="menu_mnt_master_data"  sequence="20"/>

<!-- Shift -->
	 <record id="tbl_master_shift_form" model="ir.ui.view">
        <field name="name">form.master.shift.form</field>
        <field name="model">work_shift</field>
        <field name="arch" type="xml">
            <form string="Master Shift">
              <sheet>
                <group>
					<field name="company_id"/>
					<field name="name"/>
					<field name="start_shift" widget="float_full_time" options="{'round_off': True, 'time_only': True}"/>
					<field name="end_shift" widget="float_full_time" options="{'round_off': True, 'time_only': True}"/>
                </group>
              </sheet>
            </form>
        </field>
</record>

<record id="tbl_master_shift_tree" model="ir.ui.view">
    <field name="name">tree.master.shift</field>
    <field name="model">work_shift</field>
    <field name="arch" type="xml">
        <tree string="Master Shift">
			<field name="company_id"/>
			<field name="name"/>
			<field name="start_shift"/>
			<field name="end_shift"/>
        </tree>
    </field>
</record>

<record id="action_work_shift" model="ir.actions.act_window">
    <field name="name">Work Shift</field>
    <field name="res_model">work_shift</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem name="Work Shift" id="menu_work_shift" action="action_work_shift" parent="menu_mnt_master_data"  sequence="60"/>
<!-- Shift -->

<!-- category -->
	<record id="master_asset_category_form" model="ir.ui.view">
        <field name="name">master.asset.category.form</field>
        <field name="model">master.asset.category</field>
        <field name="arch" type="xml">
            <form>
              <sheet>
                <group>
					<field name="name"/>
<!--					<field name="incoming_account"/>-->
					<field name="outgoing_account"/>
					<field name="outgoing_product"/>
					<field name="company_id"/>
                </group>
              </sheet>
            </form>
        </field>
	</record>

	<record id="master_asset_category_tree" model="ir.ui.view">
		<field name="name">master.asset.category.tree</field>
		<field name="model">master.asset.category</field>
		<field name="arch" type="xml">
			<tree>
				<field name="name"/>
<!--				<field name="incoming_account"/>-->
				<field name="outgoing_account"/>
				<field name="outgoing_product"/>
				<field name="company_id"/>
			</tree>
		</field>
	</record>

	<record id="action_master_asset_category" model="ir.actions.act_window">
		<field name="name">Category</field>
		<field name="res_model">master.asset.category</field>
		<field name="view_mode">tree,form</field>
	</record>

	<menuitem name="Asset Category" id="menu_master_asset_category" action="action_master_asset_category" parent="menu_mnt_master_data"  sequence="15"/>
