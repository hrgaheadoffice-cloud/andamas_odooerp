<?xml version="1.0"?>
<odoo>
    <record id="schedule_activity_tree" model="ir.ui.view">
        <field name="name">schedule.activity.tree</field>
        <field name="model">schedule.activity</field>
        <field name="arch" type="xml">
            <tree string="Schedule Activity">
                <field name="name"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="schedule_activity_form" model="ir.ui.view">
        <field name="name">schedule.activity.form</field>
        <field name="model">schedule.activity</field>
        <field name="arch" type="xml">
           <form>
               <sheet>
                   <group>
                       <field name="name"/>
                       <field name="company_id"/>
                   </group>
               </sheet>
           </form>
        </field>
    </record>

    <record id="action_schedule_activity" model="ir.actions.act_window">
        <field name="name">Schedule Activity</field>
        <field name="res_model">schedule.activity</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Schedule Activity" id="menu_schedule_activity" action="action_schedule_activity" parent="menu_mnt_master_data"  sequence="35"/>
</odoo>