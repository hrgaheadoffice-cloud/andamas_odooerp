<odoo>
    <record model="ir.module.category" id="module_category_maintenance">
        <field name="name">Maintenance</field>
        <field name="sequence">10</field>
    </record>

<!--Eri 202405022-->
    <record id="group_maintenance_ocr_ccr" model="res.groups">
        <field name="name">OCR/CCR</field>
        <field name="category_id" ref="module_category_maintenance" />
    </record>
    <record id="group_maintenance_plant" model="res.groups">
        <field name="name">Plant</field>
        <field name="category_id" ref="module_category_maintenance" />
    </record>
    <record id="group_maintenance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[(6,0,[ref('bisa_maintenance.group_maintenance_ocr_ccr'),ref('bisa_maintenance.group_maintenance_plant')])]" />
        <field name="category_id" ref="module_category_maintenance" />
    </record>
<!--Eri 202405022-->

<!--Eri 20240610-->
    <record model="ir.module.category" id="module_category_requisition">
        <field name="name">Requisition</field>
        <field name="sequence">10</field>
    </record>
        <record id="group_admin_plant" model="res.groups">
        <field name="name">Admin Plant</field>
        <field name="category_id" ref="module_category_requisition" />
    </record>
    <record id="group_maintenance_user_requisition" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_requisition" />
    </record>
    <record id="group_maintenance_requisition_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[(6,0,[ref('bisa_maintenance.group_admin_plant'),ref('bisa_maintenance.group_maintenance_user_requisition')])]" />
        <field name="category_id" ref="module_category_requisition" />
    </record>
