<odoo>
    <record model="ir.rule" id="reimbursement_site_comp_rule">
        <field name="name">Purchase Request multi-company</field>
        <field name="model_id" ref="model_reimbursement_site" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="category_reimbursement_site" model="ir.module.category">
        <field name="name">Reimbursement Site</field>
    </record>

    <record id="reimbursement_site_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="category_reimbursement_site"/>
    </record>
    <record id="reimbursement_site_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="category_reimbursement_site"/>
    </record>
    <record id="reimbursement_site_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="category_id" ref="category_reimbursement_site"/>
    </record>
    <record id="reimbursement_site_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="category_reimbursement_site"/>
    </record>
</odoo>