<odoo>
    <record id="yudha_payment_queue_form" model="ir.ui.view">
            <field name="name">payment.queue.form</field>
            <field name="model">payment.plan</field>
            <field name="arch" type="xml">
                <form string="Payment Queue">
                    <header>
                        <!-- Post -->
                    <!-- <button
                        name="button_approved"
                        string="Approve"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible':[('state','in',['draft','approved','paid','rejected'])]}"
                    /> -->
                    <button
                        name="button_approved_matrix"
                        states="to_approve_matrix"
                        string="Approve Matrix"
                        type="object"
                        class="oe_highlight"

                    />
                    <button
                        name="button_reject"
                        string="Reject"
                        type="object"
                        class="oe_highlight"
                        states="to_approve_matrix"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        states="rejected"
                        string="Set To Draft"
                        class="oe_highlight"
                    />
                    <button
                        name="button_to_approve"
                        type="object"
                        states="draft"
                        string="Request Approval"
                        class="oe_highlight"
                    />
                    <button
                        name="insert_ca"
                        type="object"
                        string="Insert Document"
                        class="oe_highlight"
                        states="draft"

                    />
                    <!-- <button
                        name="button_register_payment"
                        string="Create Payment"
                        type="object"
                        class="oe_highlight"
                        states="approved"
                    /> -->
                        <field name="state" widget="statusbar" statusbar_visible="draft,to_approve_matrix,approved,paid,rejected" readonly="1"/>

                    </header>
                    <!-- Invoice outstanding credits -->
                    <sheet>
                        <div name="button_box" class="oe_button_box">
<!--                            <button name="open_reconcile_view"-->
<!--                                    class="oe_stat_button"-->
<!--                                    icon="fa-bars"-->
<!--                                    type="object"-->
<!--                                    attrs="{'invisible': ['|', '|', ('move_type', '!=', 'entry'), ('id', '=', False), ('has_reconciled_entries', '=', False)]}"-->
<!--                                    string="Reconciled Entries">-->
<!--                            </button>-->
                        </div>

                        <div class="oe_title">
                            <!-- Number -->
                            <label for="name"/>
                            <h1 class="mt0">
                                <field name="name"  placeholder="Payment Plann Number"/>
                            </h1>

                        </div>
                        <group>
                            <group>
                                <field name="company_id"/>
                                 <field name="journal_id"/>
                                <!-- <field name="payment_type"/> -->
                                <field name="available_payment_method_ids" invisible="1"/>
                                <field name="amount_total" invisible="1"/>
                            </group>
                            <group>
                                <field name="payment_date" string="Request Date" />
                                <field name="journal_balance" readonly="1" force_save="1"/>
                                <field name="estimated_balance" readonly="1" force_save="1"/>
                                <field name="currency_id" invisible="1"/>
                                <!-- <field name="payment_method_id"/> -->
                                <field name="hide_payment_method" invisible="1"/>
                            </group>
                        </group>

                    <!-- <notebook>
                        <page name="plan_details" string="Payment Plan Details">
                            <field name="payment_plan_ids" attrs="{'readonly':[('state','in','paid')]}">
                                <tree editable="bottom">
                                    <field name="plan_id" invisible="1"/>
                                    <field name="dibuang" invisible="1"/>
                                    <field name="date_maturity" attrs="{'readonly': [('is_approved', '=', True)]}"/>
                                    <field name="moves_id" attrs="{'readonly': [('is_approved', '=', True)]}"/>
                                    <field name="invoice_date" attrs="{'readonly': [('is_approved', '=', True)]}"/>
                                    <field name="partner_id" attrs="{'readonly': [('is_approved', '=', True)]}"/>
                                    <field name="source_doc" attrs="{'readonly': [('is_approved', '=', True)]}"/>
                                    <field name="company_id" invisible="1"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="amount_currency" attrs="{'readonly': [('is_approved', '=', True)]}"/>
                                    <field name="state"/>
                                     <button name="action_approved" type="object"
                                            string="Approve" class="oe_highlight"
                                            attrs="{'invisible': ['|',('state','in',['paid','rejected']),('is_approved', '=', True)]}"/>
                                    <button name="action_rejected" type="object"
                                            string="Reject" class="oe_highlight"
                                            attrs="{'invisible': ['|',('state','in',['paid','rejected']),('is_rejected', '=', True)]}"/>
                                    <field name="is_approved" invisible="1"/>
                                    <field name="is_rejected" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook> -->
                    <notebook>
                        <page name="plan_details" string="Payment Detail">
                            <field name="ca_payment_ids">
                                <tree editable="bottom" create="false">
                                    <field name="ca_id" string="Number" readonly="1" force_save="1" invisible="1"/>
                                    <field name="document_number" string="Number" readonly="1" force_save="1"/>
                                    <field name="document_type"/>
                                    <field name="is_show_button" invisible="1"/>
                                    <field name="create_document_date" />
                                    <field name="amount" string="Amount" sum="Total"/>
                                    <field name="currency_id" invisible="1" />
                                    <!-- <button name="action_approved" type="object"
                                            string="Approve" class="oe_highlight"
                                            attrs="{'invisible': [('is_show_button', '=', False)]}"/> -->
                                    <button name="action_rejected" type="object"
                                            string="Reject" class="oe_highlight"
                                            attrs="{'invisible': [('is_show_button', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Approval Matrix">
                                <field name="approval_matrix_ids" readonly="1">
                                    <tree>
                                        <field name="state"/>
                                        <field name="user_ids" widget="many2many_tags"/>
                                        <field name="realization_user_id"/>
                                        <field name="date"/>
                                    </tree>
                                </field>
                            </page>
                    </notebook>
                    </sheet>
                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
        </field>
    </record>
        <record id="view_payment_plan_tree" model="ir.ui.view">
            <field name="name">payment.plan.tree</field>
            <field name="model">payment.plan</field>
            <field name="arch" type="xml">
                <tree string="Payment Plann" sample="1">
                    <field name="name"/>
                        <!-- <field name="journal_id"/> -->
                        <field name="available_payment_method_ids" invisible="1"/>
                        <field name="company_id"/>
                        <field name="payment_date" string="Request Date"/>
                        <field name="currency_id"/>
                        <!-- <field name="payment_method_id"/> -->
                        <field name="payment_type"/>
                        <field name="hide_payment_method" invisible="1"/>
                        <field name="state" readonly="1"/>

                 </tree>
            </field>
        </record>
    <record id="yudha_payment_plan_action_view" model="ir.actions.act_window">
        <field name="name">Payment Plan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">payment.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_is_noi_ho': True, 'default_move_journal_types': ('bank', 'cash')}</field>
        <field name="domain">[]</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('yudha_payment_voucher.view_payment_plan_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('yudha_payment_voucher.yudha_payment_queue_form')}),
                ]"/>

        <field name="help" type="html">
          <p class="oe_view_nocontent_create">
            No data
          </p><p>
            Click create to add one
          </p>
        </field>
    </record>
        <record id="act_payment_plan_wiz" model="ir.actions.act_window">
            <field name="name">Payment Planner</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">payment.plan</field>
            <field name="view_id" ref="yudha_payment_queue_form"/>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

</odoo>
