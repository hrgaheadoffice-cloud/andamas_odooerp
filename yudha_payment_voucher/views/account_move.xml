<odoo>
        <record id="view_move_tree_inherit_plan" model="ir.ui.view">
            <field name="name">account.move.tree.inherit.plan</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="js_class">add_to_queue</attribute>
                </xpath>
            </field>
        </record>
</odoo>