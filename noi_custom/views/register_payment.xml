<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="view_noi_payments_register_form" model="ir.ui.view">
            <field name="name">noi.payment.form</field>
            <field name="model">noi.payment</field>
            <field name="arch" type="xml">
                <form string="Register Payment">
                    <!-- Invisible fields -->
                    <group>
                        <group name="group1">
                            <field name="journal_id" widget="selection" required="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="available_partner_bank_ids" invisible="1"/>
                            <field name="partner_bank_id"/>
                            <field name="noi_id" invisible="1"/>
                            <field name="payment_type" invisible="1"/>
                            <field name="partner_type" invisible="1"/>
                            <field name="partner_id" invisible="1"/>
                            <field name="payment_difference" invisible="1"/>
                            <field name="payment_difference_handling" invisible="1"/>
                        </group>
                        <group name="group2">
                            <label for="amount"/>
                            <div name="amount_div" class="o_row">
                                <field name="amount"/>
                                <field name="currency_id"
                                       options="{'no_create': True, 'no_open': True}"
                                       groups="base.group_multi_currency"/>
                            </div>
                            <field name="payment_date"/>
                            <field name="communication"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Create Payment" name="action_create_payments" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
