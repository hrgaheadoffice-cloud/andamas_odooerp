<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_cost_center_comp_rule" model="ir.rule">
        <field name="name">Cost center multi company rule</field>
        <field name="model_id" ref="account_cost_center.model_account_cost_center" />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>
    <!-- ============================Vendor Bill Category========================================= -->
    <record id="module_category_vendor_bill" model="ir.module.category">
        <field name="name">Vendor Bill</field>
        <field name="description">Membantu mengatur akses Vendor Bill</field>
        <field name="sequence">100</field>
    </record>
    <!-- ============================Bank Statement Category========================================= -->
    <record id="module_category_bank_statement" model="ir.module.category">
        <field name="name">Bank Statement</field>
        <field name="description">Membantu mengatur akses Bank Statement</field>
        <field name="sequence">100</field>
    </record>

    <!-- Vendor Bill Group -->

    <record id="group_user_vendor_bill" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_vendor_bill"/>
        <field name="comment">User dapat mengakses Vendor Bill</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_koordinator_vendor_bill" model="res.groups">
        <field name="name">Koordinator</field>
        <field name="category_id" ref="module_category_vendor_bill"/>
        <field name="comment">Koordinator dapat mengakses Vendor Bill</field>
        <field name="implied_ids" eval="[(4, ref('group_user_vendor_bill'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_manager_vendor_bill" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_vendor_bill"/>
        <field name="comment">Manager dapat mengakses Vendor Bill</field>
        <field name="implied_ids" eval="[(4, ref('group_koordinator_vendor_bill'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <!-- Bank Statement Group -->

    <record id="group_user_bank_statement" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_bank_statement"/>
        <field name="comment">User dapat mengakses Bank Statement</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_koordinator_bank_statement" model="res.groups">
        <field name="name">Koordinator</field>
        <field name="category_id" ref="module_category_bank_statement"/>
        <field name="comment">Koordinator dapat mengakses Bank Statement</field>
        <field name="implied_ids" eval="[(4, ref('group_user_bank_statement'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_manager_bank_statement" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_bank_statement"/>
        <field name="comment">Manager dapat mengakses Bank Statement</field>
        <field name="implied_ids" eval="[(4, ref('group_koordinator_bank_statement'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
    <!-- <data> -->
        <!-- Vendor Bill Rule -->
        <record id="rule_group_user_vendor_bill" model="ir.rule">
            <field name="name">User</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="domain_force">[('prepared_by', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_user_vendor_bill'))]"/>
        </record>
        <record id="rule_group_koordinator_vendor_bill" model="ir.rule">
            <field name="name">Koordinator</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('group_koordinator_vendor_bill'))]"/>
        </record>
    
        <record id="rule_group_manager_vendor_bill" model="ir.rule">
            <field name="name">Manager</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_manager_vendor_bill'))]"/>
        </record>

        <!-- Bank Statement Rule -->
        <record id="rule_group_user_bank_statement" model="ir.rule">
            <field name="name">User</field>
            <field name="model_id" ref="model_account_bank_statement"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_user_bank_statement'))]"/>
        </record>
        <record id="rule_group_koordinator_bank_statement" model="ir.rule">
            <field name="name">Koordinator</field>
            <field name="model_id" ref="model_account_bank_statement"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('group_koordinator_bank_statement'))]"/>
        </record>
    
        <record id="rule_group_manager_bank_statement" model="ir.rule">
            <field name="name">Manager</field>
            <field name="model_id" ref="model_account_bank_statement"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_manager_bank_statement'))]"/>
        </record>
    </data>

</odoo>
