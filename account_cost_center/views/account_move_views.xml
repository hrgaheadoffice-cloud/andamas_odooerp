    <record id="account_vendor_bill_bisa_tree" model="ir.ui.view">
        <field name="name">account_vendor_bill_bisa.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
              <xpath expr="//field[@name='invoice_date']" position="replace">
                <field name="invoice_date" optional="show" invisible="context.get('default_move_type') not in ('in_invoice', 'in_refund','in_receipt')" string="Receipt Date"/>
              </xpath>
        </field>
     </record>
    <record id="account_vendor_bill_bisa_tree1" model="ir.ui.view">
        <field name="name">account_vendor_bill_bisa.tree1</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
              <xpath expr="//field[@name='state']" position="replace">
                <field name="state" invisible="1"/>
                <field name="state_new" string="Status" widget="badge" decoration-success="state_new == 'posted'" decoration-info="state_new == 'draft'" optional="show"/>
              </xpath>
              <xpath expr="//field[@name='name']" position="before">
                
                <field name="pre_num"/>
              </xpath>
        </field>
     </record>

<!-- ALASAN REJECT -->
    <record id="account_move_cancel_wizard" model="ir.ui.view">
        <field name="name">account_move_cancel_wizard.form</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
           <form duplicate="0" delete="0" create="0">
              <group>
                    
                    <field name="alasan_cancel" required="1"/>
                    <field name="state" invisible="1"/>
              </group>
              <footer>
                 
                 <button name="button_cancel"  string="Yes" class="btn-primary" type="object"/>
                 <button string="No" class="btn-secondary" special="cancel"/>
              </footer>
           </form>
        </field>
     </record>
