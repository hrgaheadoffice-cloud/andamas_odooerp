<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="cos_center_res_users_inherit" model="ir.ui.view">
            <field name="name">cos_center_res_users.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='access_rights']/group[1]" position="after">
                    <group string="Cost Center">
                        <field name="cost_center_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </xpath>
            </field>
        </record>


    </data>
</odoo>