<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']"
                position="after"
            >
                <field name="cost_center_id" />
            </xpath>
            <xpath
                expr="//field[@name='line_ids']/tree/field[@name='account_id']"
                position="after"
            >
                <field name="cost_center_id" />
            </xpath>
            <field name="ref" position="after">
                <field name="cost_center_id" />
            </field>
            <xpath expr="//group[1]/group[2]/div[1]" position="replace">
                <div class="o_td_label">
                    <label for="invoice_date" string="Invoice Date" style="font-weight:bold;" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt'))]}"/>
                    <label for="invoice_date" string="Receipt Date" style="font-weight:bold;" attrs="{'invisible': [('move_type', 'not in', ('in_invoice', 'in_refund', 'in_receipt'))]}"/>
                </div>
              </xpath>
              <xpath expr="//field[@name='invoice_date']" position="attributes">
                <attribute name="required">1</attribute>
              </xpath>
              <xpath expr="//field[@name='state']" position="replace">
                <!-- <button name="action_samakan" string="samakan" type="object"/> -->
                <button
                        name="button_to_approve_request"
                        string="Request approve"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|',('move_type', '!=', 'in_invoice'), ('state_new', '!=', 'draft')]}"
                    />
                <button
                        name="button_verify"
                        string="Verify"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|',('move_type', '!=', 'in_invoice'), ('state_new', '!=', 'to_verify')]}"
                    />
                <button
                        name="button_approved1"
                        string="Approve 1"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|',('move_type', '!=', 'in_invoice'), ('state_new', '!=', 'approved1')]}"
                    />
                <button
                        name="button_approved2"
                        string="Approve 2"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|',('move_type', '!=', 'in_invoice'), ('state_new', '!=', 'approved2')]}"
                    />
                <button
                        name="button_approved3"
                        string="Approve 3"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': ['|',('move_type', '!=', 'in_invoice'), ('state_new', '!=', 'approved3')]}"
                    />
                <button
                        name="action_preview_cancel"
                        string="Cancel"
                        type="object"
                        attrs="{'invisible': ['|',('move_type', '!=', 'in_invoice'), ('state', '!=', 'draft')]}"
                    />
                <button
                    name="action_print"
                    string="Print"
                    type="object"
                />
                <field name="state" widget="statusbar" statusbar_visible="draft,posted" attrs="{'invisible': [('move_type', '=', 'in_invoice')]}"/>
                <field name="state_new" widget="statusbar" statusbar_visible="draft,to_verify,approved1,approved2,approved3,posted" attrs="{'invisible': [('move_type', '!=', 'in_invoice')]}"/>
              </xpath>
              <!--<xpath expr="//button[@name='button_cancel']" position="replace">
&lt;!&ndash;                <button name="button_cancel" string="Cancel Entry" type="object" groups="account.group_account_invoice" attrs="{'invisible' : ['|', '|',('id', '=', False), ('state', '!=', 'draft'),('move_type', '=', 'in_invoice')]}"/>&ndash;&gt;
                &lt;!&ndash; <attribute name="invisibles">1</attribute> &ndash;&gt;
              </xpath>-->
              <xpath expr="//button[2]" position="replace">
                <button name="action_post" string="Confirm" class="oe_highlight" type="object" groups="account.group_account_invoice" attrs="{'invisible': ['|', '|', ('state', '!=', 'draft'), ('auto_post', '=', True), ('move_type', 'in', ('entry','in_invoice'))]}"/>
                <!-- <attribute name="invisibles">1</attribute> -->
              </xpath>
              <xpath expr="//field[@name='name']" position="replace">
                <field name="name" attrs="{'readonly': [('state_new', '!=', 'draft')]}" placeholder="JRNL/2016/00001"/>
                <!-- <attribute name="invisibles">1</attribute> -->
              </xpath>
            <xpath expr="//group[1]" position="after">
                <group attrs="{'invisible': [('move_type', '!=', 'in_invoice')]}">
                    <group>
                        <table>
                        <tr >
                            <td><label for="prepared_by"/></td>
                            <td></td>
                            <td></td>
                            <td><field name="prepared_by"/></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right"><field name="prepare_dt" readonly="1"/></td>
                        </tr>
                        <tr >
                            <td><label for="verified_by"/></td>
                            <td></td>
                            <td></td>
                            <td><field name="verified_by" attrs="{'required': [('move_type', '=', 'in_invoice')]}"/></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right"><field name="verify_dt" readonly="1"/></td>
                        </tr>
                        <tr >
                            <td><label for="appr1"/></td>
                            <td></td>
                            <td></td>
                            <td><field name="appr1"/></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right"><field name="appr1_dt" readonly="1"/></td>
                        </tr>
                        <tr >
                            <td><label for="appr2"/></td>
                            <td></td>
                            <td></td>
                            <td><field name="appr2"/></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right"><field name="appr2_dt" readonly="1"/></td>
                        </tr>
                        <tr >
                            <td><label for="appr3"/></td>
                            <td></td>
                            <td></td>
                            <td><field name="appr3"/></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right"><field name="appr3_dt" readonly="1"/></td>
                        </tr>
                    </table>
                        
                    </group>
                    <group>


                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <record id="account_vendor_bill_bisa_tree" model="ir.ui.view">
        <field name="name">account_vendor_bill_bisa.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
              <xpath expr="//field[@name='invoice_date']" position="replace">
                <field name="invoice_date" optional="show" invisible="context.get('default_move_type') not in ('in_invoice', 'in_refund','in_receipt')" string="Receipt Date"/>
              </xpath>
        </field>
     </record>
    <record id="account_vendor_bill_bisa2_tree" model="ir.ui.view">
        <field name="name">account_vendor_bill_bisa2.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
              <xpath expr="//field[@name='state']" position="replace">
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'" invisible="1"/>
                <field name="state_new" string="Status" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'" optional="show"/>
              </xpath>
        </field>
     </record>

<!-- ALASAN REJECT -->
    <record id="account_move_cancel_wizard" model="ir.ui.view">
        <field name="name">account_move_cancel_wizard.form</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
           <form duplicate="0" delete="0" create="0">
              <group>
                    
                    <field name="alasan_cancel" required="1"/>
                    <field name="state" invisible="1"/>
              </group>
              <footer>
                 
                 <button name="button_cancel"  string="Yes" class="btn-primary" type="object"/>
                 <button string="No" class="btn-secondary" special="cancel"/>
              </footer>
           </form>
        </field>
     </record>
<!-- TUTUP -->

</odoo>
