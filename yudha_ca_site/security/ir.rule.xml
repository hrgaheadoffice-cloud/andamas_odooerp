<odoo>
    <record model="ir.rule" id="cash_advance_site_comp_rule">
        <field name="name">Purchase Request multi-company</field>
        <field name="model_id" ref="model_cash_advance_site" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>
    <record model="ir.rule" id="settelment_site_comp_rule">
        <field name="name">Purchase Request multi-company</field>
        <field name="model_id" ref="model_settelment_site" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="category_cash_advance_site" model="ir.module.category">
        <field name="name">Cash Advance Site</field>
    </record>

    <record id="cash_advance_site_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="category_cash_advance_site"/>
    </record>
    <record id="cash_advance_site_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="category_cash_advance_site"/>
    </record>
    <record id="cash_advance_site_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="category_id" ref="category_cash_advance_site"/>
    </record>
    <record id="cash_advance_site_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="category_cash_advance_site"/>
    </record>

    <record id="category_settlement_site" model="ir.module.category">
        <field name="name">Settlement Site</field>
    </record>

    <record id="settlement_site_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="category_settlement_site"/>
    </record>
    <record id="settlement_site_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="category_settlement_site"/>
    </record>
    <record id="settlement_site_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="category_id" ref="category_settlement_site"/>
    </record>
    <record id="settlement_site_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="category_settlement_site"/>
    </record>
</odoo>