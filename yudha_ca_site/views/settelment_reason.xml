<odoo>
    <data>

        <record id="view_settelment_reason_site_form" model="ir.ui.view">
            <field name="name">settelment.reason.site.form</field>
            <field name="model">settelment.reason.sitewiz</field>
            <field name="arch" type="xml">
                <form string="Register Payment">
                    <!-- Invisible fields -->
                    <group>
                       <field name="alasan"/>
                       <field name="settelment_ids" invisible="1"/>
                    </group>
                    <footer>
                        <button string="Apply" name="action_apply" type="object" class="oe_highlight"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
