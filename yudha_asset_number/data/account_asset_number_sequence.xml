<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!--
        Account Asset Number Sequences
        -->
<!--        <data noupdate="1">-->
            <record id="sequence_account_asset_seq" model="ir.sequence">
                <field name="name">Account Asset Number sequence</field>
                <field name="code">account.asset.number</field>
                <field name="prefix">FAA/%(InitPT)s/%(month)s/%(year)s/</field>
                <field name="padding">3</field>
                <field name="implementation">no_gap</field>
                <field eval="False" name="company_id"/>
            </record>
<!--        </data>-->
</odoo>
