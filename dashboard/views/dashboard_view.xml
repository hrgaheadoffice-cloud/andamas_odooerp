<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record model="ir.ui.view" id="dashboard_kanban_view">
			<field name="name">Approval Summary</field>
			<field name="model">dashboard.dashboard</field>
			<field name="type">kanban</field>
			<field name="arch" type="xml">
				<kanban create="false">
					<field name="field_list"/>
					<field name="chart_list"/>
					<templates>
						<t t-name="kanban-box">
							<div class="o_kanban_view o_kanban_ungrouped o_kanban_record own">
								<div class="row col-xs-12">
									<button id="refresh" class="btn btn-default btn-setting pull-right btn-dadhboard">
										<i class="fa fa-refresh"/>
										Refresh
									</button>
									<button name="action_setting" type="object" groups="dashboard.dashboard_manager" class="btn btn-default btn-setting pull-right ">
										<i class="fa fa-cog"/>
										customize
									</button>
								</div>
								<div class="row col-xs-12">
									<div t-foreach="record.field_list.selection" class="col-lg-3 col-md-6" t-as="field">
										<!--###Original###-->
										<!--<div t-att-class="'panel panel-'+field[2]">-->
										<!--##############-->
										<a type="object" name="view_details" t-att-data-context="`{'action_id':`+field[4]+`,'active_ids':[`+field[5]+`]}`">
										
										<div class="panel panel-default" t-attf-style="border-color: {{field[6]}}!important;">
											<div class="panel-heading" t-attf-style="background-color: {{field[6]}}!important; border-color: {{field[6]}}!important;">
												<div class="panel-footer">
													<span class="pull-left"><i t-att-class="'fa fa-5x '+field[3]"/>  </span>
													<span class="pull-right huge" style="color: white">
		
														<t t-esc="field[0]"/>
													</span>
													
													<div class="clearfix"/>
												</div>
												<div class="panel-footer">
												      <span class="pull-right">
																
																	<h2 style="color: white">
																		<t t-esc="field[1]"/> <i class="fa fa-arrow-circle-right"/>
																	</h2>
																
															</span>
															<div class="clearfix"/>
												</div>
											</div>
												<a type="object" name="view_details" t-att-data-context="`{'action_id':`+field[4]+`,'active_ids':[`+field[5]+`]}`">
												<div class="panel-footer">
													<span class="pull-left">View Details</span>
													<span class="pull-right">
														<i class="fa fa-arrow-circle-right"/>
													</span>
													<div class="clearfix"/>
												</div>
											</a>
										</div>
										</a>
									</div>
								</div>
								<!-- /.row -->
								<div class="row col-xs-12">
									<div t-foreach="record.chart_list.selection" t-as="chart" class="col-lg-6 col-xs-12">
										<t t-if="chart[2]==1">
											<div class="panel panel-default">
												<div class="panel-heading">
													<i class="fa fa-bar-chart-o fa-fw"/>
													<t t-esc="chart[1]"/>
												</div>
												<div class="panel-body">
													<div t-att-id="'morris-area-chart'+chart[0]"/>
												</div>
											</div>
										</t>
										<t t-if="chart[2]==2">
											<div class="panel panel-primary">
												<div class="panel-heading">
													<h3 class="panel-title">
														<i class="fa fa-long-arrow-right"/>
														<t t-esc="chart[1]"/>
													</h3>
												</div>
												<div class="panel-body">
													<div t-att-id="'morris-bar-chart'+chart[0]"/>
												</div>
											</div>
										</t>
									</div>
								</div>
							<script src="/dashboard/static/src/js/morris.js"/>
							<script src="/dashboard/static/src/js/morrisdata.js"/>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>
	<record id="dashboard_action_view" model="ir.actions.act_window">
		<field name="name">Approval Summary</field>
		<field name="res_model">dashboard.dashboard</field>
		<!-- <field name="view_type">form</field> -->
		<field name="view_mode">kanban,tree</field>
	</record>
	<menuitem id="dashboard_root" name="Approval Summary" sequence="0"
		web_icon="dashboard,static/description/icon.png"/>
	<menuitem id="dashboard_menu" name="Approval Summary" parent="dashboard_root"
		action="dashboard_action_view" sequence="1"/>
</odoo>
