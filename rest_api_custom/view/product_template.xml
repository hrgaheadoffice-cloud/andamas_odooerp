<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherited partner form view -->
    <record model='ir.ui.view' id='product_template_only_form_view_custom'>
        <field name="name">product.template.only.form.view.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Inventory Calculation" type="object"
                    name="inventory_calculation" attrs="{'invisible': [('name', '!=', 'COAL')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
