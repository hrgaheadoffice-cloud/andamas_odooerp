<!--<?xml version="1.0" encoding="utf-8"?>-->
<odoo>
    <record id="fuel_stock_tree_view" model="ir.ui.view">
        <field name="name">fuel.stock.tree.view</field>
        <field name="model">fuel.stock</field>
        <field name="arch" type="xml">
            <tree>
                <field name="created_by"/>
                <field name="date"/>
                <field name="vendor"/>
                <field name="truck"/>
                <field name="operator"/>
                <field name="refueling"/>
<!--                <field name="final_balance"/>-->
            </tree>
        </field>
    </record>

    <record id="fuel_stock_form_view" model="ir.ui.view">
        <field name="name">fuel.stock.form.view</field>
        <field name="model">fuel.stock</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="action_submit" class="oe_highlight" string="Submit" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="created_by"/>
                            <field name="date"/>
                            <field name="vendor"/>
                            <field name="seal_number"/>
                            <field name="baps_number"/>
                        </group>
                        <group>
                            <field name="truck"/>
                            <field name="operator"/>
                            <field name="refueling"/>
                        </group>
<!--                        <field name="final_balance"/>-->
                    </group>
                    <notebook>
                            <page string='Detail Refueling'>
                                <field name="refueling_detail">
                                    <tree editable="bottom">
<!--                                        <field name="fuel_stock_id" invisible="1"/>-->
                                        <field name="field_destination"/>
                                        <field name="quantity"/>
                                    </tree>
                                </field>
                            </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="fuel_stock_action" model="ir.actions.act_window">
        <field name="name">Fuel Stock</field>
        <field name="res_model">fuel.stock</field>
        <field name="view_mode">tree,form</field>
    </record>

<!--    <menuitem action="fuel_stock_action" id="menu_fuel_stock" name="Fuel Stock" parent="menu_fuel_management_root" sequence="10"/>-->
</odoo>