<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.rule" id="fuel_consumption_comp_rule">
        <field name="name">Fuel Consumption multi-company</field>
        <field name="model_id" ref="model_fuel_consumption" /> 
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>
    <record model="ir.rule" id="fuel_source_comp_rule">
        <field name="name">Fuel Source multi-company</field>
        <field name="model_id" ref="model_fuel_source" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>
</odoo>