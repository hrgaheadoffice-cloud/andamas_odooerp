<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <template id="report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document">
            <xpath expr="." position="replace">
                <t t-call="bisa_maintenance_print.custom_layout">
                    <t t-set="report_type" t-value="'po'"/>
                    <t t-set="doc" t-value="o.with_context(lang=o.partner_id.lang)" />

                    <div class="page" style="font-size: 8px !important;">
                        <div class="oe_structure"/>
                        <div class="row header_doc">
                            <div class="row col-12" style="margin-top: 75px; font-size: 10px !important;">
                                <div class="col-6 mb4">
                                    <div class="row">
                                        <div class="col-12 mb4">
                                            <h5>VENDOR</h5>
                                        </div>
                                    </div>
                                    <div class="vendor-info">
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div>Company Name</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.partner_id" /></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div>Street Address</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.partner_id.street" /></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div>City, State</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.partner_id.city" />, <span t-field="doc.partner_id.state_id" /></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div>Phone</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.partner_id.phone" /></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 mb4">
                                    <div class="row">
                                        <div class="col-12 mb4">
                                            <h4>OTHER INFORMATION</h4>
                                        </div>
                                    </div>
                                    <div class="other-info">
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div>Source Document</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.origin"/></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div>Purchase Request</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.pr_id"/></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div style="margin-left: 0px;" class="row">Procurement Category</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.proc_group_id"/></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div style="margin-left: 0px;" class="row">Payment Term</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.payment_term_id"/></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div style="margin-left: 0px;" class="row">Bill to</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div style="margin-left: 0px;" class="row">Description</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                       </div>
                        <div style="margin: 16px;">
                            <div class="row">
                                <h4>SHIP TO</h4>
                            </div>
                            <div  t-if="doc.company_id.name == 'BUANA ELTRA'" class="row">
                                <span t-field="doc.picking_type_id.warehouse_id.partner_id"/>
                            </div>
                            <div  t-else="else" class="row">
                                <span t-field="doc.picking_type_id"/>
                            </div>
                        </div>
                        <style>
                            table, th, td {
                                border: 1px solid black !important;
                            }
                        </style>
                        <table style="margin-top: 50px;" class="table custom-table-bordered table-sm o_main_table">
                            <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                            <thead style="display: table-row-group; background-color: #0E709A; color: white;">
                                <tr>
                                    <th name="th_no" class="text-left">NO.</th>
                                    <th name="th_reference_no" class="text-left">REFERENCE NO.</th>
                                    <th name="th_description" class="text-left">DESCRIPTION</th>
                                    <th name="th_quantity" class="text-right">QTY</th>
                                    <th name="th_uom" class="text-right">UOM</th>
                                    <th name="th_taxes" class="text-right">Taxes</th>
                                    <th name="th_discount" class="text-right">Discount</th>
                                    <th name="th_price_per_unit" class="text-right">Price per Unit</th>
                                    <th name="th_subtotal" class="text-right">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody class="sale_tbody">

                                <t t-set="current_subtotal" t-value="0"/>
                                <t t-set="index" t-value="0"/>

                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-set="index" t-value="index + 1"/>
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>


                                    <tr class="bg-200 font-weight-bold o_line_section">
                                        <td name="td_no"><span t-esc="index"/></td>
                                        <td name="td_ref_no"><span t-field="line.product_id.default_code"/></td>
                                        <td name="td_name"><span t-field="line.name"/></td>
                                        <td name="td_quantity" class="text-right">
                                            <span t-field="line.product_qty"/>
                                        </td>
                                        <td name="td_uom" class="text-right">
                                            <span t-field="line.product_uom"/>
                                        </td>
                                        <td name="td_taxes" class="text-right">
                                            <span t-esc="', '.join(map(lambda x: x.description, line.taxes_id))"/>
                                        </td>
                                        <td name="td_disc" class="text-right">
                                             <span t-field="line.fixed_discount"/>
                                        </td>
                                        <td name="td_priceunit" class="text-right">
                                             <span t-field="line.price_unit"/>
                                        </td>
                                        <td name="td_subtotal" class="text-right">
                                             <span t-field="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="text-right">
                                    <td colspan="7"/>
                                    <td>
                                        <strong class="mr16">Taxes</strong>
                                    </td>
                                    <td>
                                        <span
                                            t-esc="doc.amount_tax"
                                            t-options='{"widget": "monetary", "display_currency": doc.currency_id}'
                                        /><br/>
                                    </td>
                                </tr>
                                <tr class="text-right">
                                    <td colspan="7"/>
                                    <td>
                                        <strong class="mr16">TOTAL AMOUNT</strong>
                                    </td>
                                    <td>
                                        <span
                                            t-esc="doc.amount_total"
                                            t-options='{"widget": "monetary", "display_currency": doc.currency_id}'
                                        /><br/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <table style="border: 0px!important;">
                            <tr>
                                <td t-if="doc.user_id" class="text-center" style="border: 0px!important;">
                                    <span>Prepared By</span>
                                    <div>
                                        <div style="margin-top: 50px;">
                                            <span>(<span t-field="doc.user_id"/>)</span>
                                        </div>
                                        <span t-field="doc.create_date" style="margin-top: 50px; margin-right: 40px; margin-left: 40px;"/>
                                    </div>
                                </td>
                                <td t-if="doc.appr1" class="text-center" style="border: 0px!important;">
                                    <span>Approved 1 By</span>
                                    <div>
                                        <div style="margin-top: 50px;">
                                            <span>(<span t-field="doc.appr1"/>)</span>
                                        </div>
                                        <span t-field="doc.appr1_dt" style="margin-top: 50px; margin-right: 40px; margin-left: 40px;"/>
                                    </div>
                                </td>
                                <td t-if="doc.appr2" class="text-center" style="border: 0px!important;">
                                    <span>Approved 2 By</span>
                                    <div>
                                        <div style="margin-top: 50px;">
                                            <span>(<span t-field="doc.appr2"/>)</span>
                                        </div>
                                        <span t-field="doc.appr2_dt" style="margin-top: 50px; margin-right: 40px; margin-left: 40px;"/>
                                    </div>
                                </td>
                                <td t-if="doc.appr3" class="text-center" style="border: 0px!important;">
                                    <span>Approved 3 By</span>
                                    <div>
                                        <div style="margin-top: 50px;">
                                            <span>(<span t-field="doc.appr3"/>)</span>
                                            <span t-field="doc.appr3_dt" style="margin-top: 50px; margin-right: 40px; margin-left: 40px;"/>
                                        </div>
                                    </div>
                                </td>
                                <td t-if="doc.appr4" class="text-center" style="border: 0px!important;">
                                    <span>Approved 4 By</span>
                                    <div>
                                        <div style="margin-top: 50px;">
                                            <span>(<span t-field="doc.appr4"/>)</span>
                                            <span t-field="doc.appr4_dt" style="margin-top: 50px; margin-right: 40px; margin-left: 40px;"/>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </xpath>
       </template>
    </data>
</odoo>