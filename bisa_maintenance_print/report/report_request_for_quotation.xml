<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <template id="report_purchasequotation_document" inherit_id="purchase.report_purchasequotation_document">
            <xpath expr="." position="replace">
                <t t-call="bisa_maintenance_print.custom_layout">
                    <t t-set="report_type" t-value="'rfq'"/>
                    <t t-set="doc" t-value="o.with_context(lang=o.partner_id.lang)" />

                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row header_doc">
                            <div class="row col-12" style="margin-top: 75px;">
                                <div class="col-6 mb4">
                                    <div class="row">
                                        <div class="col-12 mb4">
                                            <h4>VENDOR</h4>
                                        </div>
                                    </div>
                                    <div class="vendor-info">
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div>Company Name</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.partner_id" /></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div>Street Address</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.partner_id.street" /></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div>City, State</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.partner_id.city" />, <span t-field="doc.partner_id.state_id" /></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div>Phone</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.partner_id.phone" /></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 mb4">
                                    <div class="row">
                                        <div class="col-12 mb4">
                                            <h4>OTHER INFORMATION</h4>
                                        </div>
                                    </div>
                                    <div class="other-info">
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div>Source Document</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.origin"/></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div style="margin-left: 0px;" class="row">Procurement Category</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-field="doc.proc_group_id"/></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div style="margin-left: 0px;" class="row">Payment Term</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: <span t-if="report_type == 'rfq'" t-field="doc.payment_term_id"/></div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div style="margin-left: 0px;" class="row">Bill to</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 mb4 label">
                                                <div style="margin-left: 0px;" class="row">Description</div>
                                            </div>
                                            <div class="col-6 mb4 value">
                                                <div>: </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                       </div>
                        <div style="margin: 16px;">
                            <div class="row">
                                <h4>SHIP TO</h4>
                            </div>
                            <div class="row">
                                <span t-field="doc.picking_type_id.warehouse_id"/>
                            </div>
                        </div>
                        <style>
                            table, th, td {
                                border: 1px solid black !important;
                            }
                        </style>
                        <table style="margin-top: 50px;" class="table custom-table-bordered table-sm o_main_table">
                        <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                        <thead style="display: table-row-group; background-color: #0E709A; color: white;">
                            <tr>
                                <th name="th_no" class="text-left">NO.</th>
                                <th name="th_reference_no" class="text-left">REFERENCE NO.</th>
                                <th name="th_description" class="text-left">DESCRIPTION</th>
                                <th name="th_quantity" class="text-right">QTY</th>
                                <th name="th_uom" class="text-right">UOM</th>
                            </tr>
                        </thead>
                        <tbody class="sale_tbody">

                            <t t-set="index" t-value="0"/>

                            <t t-foreach="doc.order_line" t-as="line">
                                <t t-set="index" t-value="index + 1"/>

                                <tr class="bg-200 font-weight-bold o_line_section">
                                    <td name="td_no"><span t-esc="index"/></td>
                                    <td name="td_ref_no"><span t-field="line.product_id.default_code"/></td>
                                    <td name="td_name"><span t-field="line.name"/></td>
                                    <td name="td_quantity" class="text-right">
                                        <span t-field="line.product_qty"/>
                                    </td>
                                    <td name="td_uom" class="text-right">
                                        <span t-field="line.product_uom"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    </div>
                </t>
            </xpath>
       </template>
    </data>
</odoo>