<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_cargo_manifest_document">

            <t t-call="bisa_maintenance_print.custom_layout">
                <t t-set="report_type" t-value="'cm'"/>
                <t t-set="doc" t-value="doc.with_context(lang=doc.user_id.lang)" />

                <div class="page" style="font-size: 8px !important;">
                    <div class="oe_structure"/>

                    <div class="row header_doc">
                        <div class="row col-12" style="margin-top: 75px; font-size: 10px !important;">
                            <div class="col-6 mb4">
                                <div class="row">
                                    <div class="col-12 mb4">
                                        <h6>INFORMATION</h6>
                                    </div>
                                </div>
                                <div class="vendor-info">
                                    <div class="row">
                                        <div class="col-6 mb4 label">
                                            <div>Transport</div>
                                        </div>
                                        <div class="col-6 mb4 value">
                                            <div>: <span t-field="doc.transport" /></div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6 mb4 label">
                                            <div>Driver</div>
                                        </div>
                                        <div class="col-6 mb4 value">
                                            <div>: <span t-field="doc.driver" /></div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6 mb4 label">
                                            <div>Ship From</div>
                                        </div>
                                        <div class="col-6 mb4 value">
                                            <div>: <span t-field="doc.ship_from" /></div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6 mb4 label">
                                            <div>Ship To</div>
                                        </div>
                                        <div class="col-6 mb4 value">
                                            <div>: <span t-field="doc.ship_to" /></div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6 mb4 label">
                                            <div>Description</div>
                                        </div>
                                        <div class="col-6 mb4 value">
                                            <div>: <span t-field="doc.description" /></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                   </div>
                    <style>
                        table, th, td {
                            border: 1px solid black !important;
                        }
                    </style>
                    <table style="margin-top: 50px;" class="table custom-table-bordered table-sm o_main_table">
                        <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                        <thead style="display: table-row-group; background-color: #0E709A; color: white;">
                            <tr>
                                <th name="th_no" class="text-left">NO.</th>
                                <th name="th_no_po" class="text-left">NO. PO</th>
                                <th name="th_no_pr" class="text-left">NO. PR</th>
                                <th name="th_no_wo" class="text-left">NO. WO</th>
                                <th name="th_unit_code" class="text-left">UNIT CODE</th>
                                <th name="th_requester" class="text-left">REQUESTOR</th>
                                <th name="th_product" class="text-left">
                                    <span>PRODUCT</span>
                                </th>
                                <th name="th_qty_order" class="text-left">
                                    <span>QTY ORDER</span>
                                </th>
                                <th name="th_uom" class="text-left">
                                    <span>UOM</span>
                                </th>
                                <th name="th_qty_cargo" class="text-left">
                                    <span>QTY CARGO</span>
                                </th>
                                <th name="th_remarks" class="text-left" style="width: 125px !important;">
                                    <span>REMARKS</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="sale_tbody">

                            <t t-set="index" t-value="0"/>

                            <t t-foreach="doc.purchase_order_line" t-as="line">
                                <t t-set="index" t-value="index + 1"/>

                                <tr class="bg-200 font-weight-bold o_line_section">
                                    <td name="td_no"><span t-esc="index"/></td>
                                    <td name="td_po"><span t-field="line.order_id"/></td>
                                    <td name="td_pr"><span t-field="line.pr_id"/></td>
                                    <td name="td_wo" class="text-left">
                                        <span t-field="line.wo_id"/>
                                    </td>
                                    <td name="td_unit_code" class="text-left">
                                        <span t-field="line.equipment_id"/>
                                    </td>
                                    <td name="td_requestor" class="text-left">
                                        <span t-field="line.requestor"/>
                                    </td>
                                    <td name="td_product" class="text-left">
                                        <span t-field="line.product_id"/>
                                    </td>
                                    <td name="td_qty_order" class="text-left">
                                        <span t-field="line.product_qty"/>
                                    </td>
                                    <td name="td_uom" class="text-left">
                                        <span t-field="line.product_uom"/>
                                    </td>
                                    <td name="td_qty_cargo" class="text-left">
                                        <span t-field="line.qty_cm"/>
                                    </td>
                                    <td name="td_remark" class="text-left">
                                        <span t-field="line.remarks"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="row mt32 ml64 mr4 text-center" style="margin-left: 16px; margin-right: 16px;" name="signature">
                        <div class="col-4">
                            <div class="text-center">
                                <span style="font-weight: 700;">Dibuat Oleh,</span>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <span style="margin-top: 100px;">
                                    (______________________)
                                </span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="text-center">
                                <span style="font-weight: 700;">Dikirim Oleh,</span>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <span style="margin-top: 100px;">
                                    (______________________)
                                </span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="text-center">
                                <span style="font-weight: 700;">Diterima Oleh,</span>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <span style="margin-top: 100px;">
                                    (______________________)
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="oe_structure"/>
                </div>
            </t>
        </template>
        <template id="report_cargo_manifest">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="bisa_maintenance_print.report_cargo_manifest_document"/>
                </t>
            </t>
        </template>
       <record id="action_report_cargo_manifest" model="ir.actions.report">
<!--            <field name="name">Cargo Manifest</field>-->
            <field name="model">cargo.manifest</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">bisa_maintenance_print.report_cargo_manifest</field>
            <field name="report_file">bisa_maintenance_print.report_cargo_manifest</field>
            <field name="print_report_name">'Cargo Manifest - %s' % (object.name)</field>
            <field name="binding_model_id" ref="cargo_manifest.model_cargo_manifest"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>