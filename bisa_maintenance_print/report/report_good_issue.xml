<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_good_issue_document">

            <t t-call="bisa_maintenance_print.custom_layout">
                <t t-set="report_type" t-value="'good_issue'"/>
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />

                <div class="page" style="font-size: 8px !important;">
                    <div class="oe_structure"/>

                    <div class="row header_doc">
                        <div class="row col-12" style="margin-top:10px; font-size: 10px !important;">
                            <div class="col-6 mb4">
                                <div class="row">
                                    <div class="col-12">
                                        <h6>INFORMATION</h6>
                                    </div>
                                </div>
                                <div class="vendor-info">
                                    <div class="row">
                                        <div class="col-6 mb4 label">
                                            <div>PR/WO</div>
                                        </div>
                                        <div class="col-6 mb4 value">
                                            <div>: <span t-field="doc.origin"/></div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6 mb4 label">
                                            <div>Description</div>
                                        </div>
                                        <div class="col-6 mb4 value">
                                            <div>: <span t-field="doc.description"/></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                   </div>
                    <style>
                        table, th, td {
                            border: 1px solid black !important;
                        }
                        .sale_tbody td[name="td_remarks"] {
                            width: 40%;
                        }
                    </style>
                    <table style="margin-top: 10px;" class="table custom-table-bordered table-sm o_main_table">
                        <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                        <thead style="display: table-row-group; background-color: #0E709A; color: white;">
                            <tr>
                                <th name="th_no" class="text-left">No</th>
                                <th name="th_part_number" class="text-left">Part Number</th>
                                <th name="th_part_name" class="text-left">Part Name</th>
                                <th name="th_quantity" class="text-right">QTY</th>
                                <th name="th_uom" class="text-right">UOM</th>
                                <th name="th_remark" class="text-center">Remark</th>
                            </tr>
                        </thead>
                        <tbody class="sale_tbody">
                            <t t-set="index" t-value="0"/>

                            <t t-foreach="doc.move_line_ids_without_package" t-as="line">
                                <t t-set="index" t-value="index + 1"/>

                                <tr class="bg-200 font-weight-bold o_line_section">
                                    <td name="td_no"><span t-esc="index"/></td>
                                    <td name="td_part_number"><span t-field="line.product_id.default_code"/></td>

                                    <td name="td_part_name"><span t-field="line.product_id.name"/></td>
                                    <td name="td_quantity" class="text-right">
                                        <span t-field="line.qty_done"/>
                                    </td>
                                    <td name="td_uom" class="text-right">
                                        <span t-field="line.product_uom_id"/>
                                    </td>
                                    <td name="td_remarks"><span t-field="doc.note"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <table class="text-center" style="border: 0px!important; margin-top: 10px; width: 100%">
                        <tr>
                            <td class="text-center" style="border: 0px!important;">
                                <span>Dikeluarkan Oleh,</span>
                                <div style="margin-top: 80px;">
                                    <span>(______________________)</span>
                                </div>
                                <span>        Logistic</span>
                            </td>
                            <td class="text-center" style="border: 0px!important;">
                                <span>Diterima Oleh,</span>
                                <div style="margin-top: 80px;">
                                    <span>(______________________)</span>
                                </div>
                                <span>        (Penerima)</span>
                            </td>
                            <td class="text-center" style="border: 0px!important;">
                                <span>Diketahui Oleh,</span>
                                <div style="margin-top: 80px;">
                                    <span>(______________________)</span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <div class="oe_structure"/>
                </div>
            </t>
        </template>
        <template id="report_good_issue">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="bisa_maintenance_print.report_good_issue_document" t-lang="doc.partner_id.lang"/>
                </t>
            </t>
        </template>
       <record id="action_report_good_issue" model="ir.actions.report">
            <field name="name">Good Issue</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">bisa_maintenance_print.report_good_issue</field>
            <field name="report_file">bisa_maintenance_print.report_good_issue</field>
            <field name="print_report_name">'Good Issue - %s' % (object.name)</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_a5"/>
        </record>
    </data>
</odoo>