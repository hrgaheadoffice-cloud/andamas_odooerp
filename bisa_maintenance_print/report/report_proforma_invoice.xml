<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document">
            <xpath expr="." position="replace">
                <t t-call="bisa_maintenance_print.custom_layout">
                    <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
                    <t t-if="not company">
                        <!-- Multicompany -->
                        <t t-if="company_id">
                            <t t-set="company" t-value="company_id"/>
                        </t>
                        <t t-elif="doc and 'company_id' in doc and doc.company_id.sudo()">
                            <t t-set="company" t-value="doc.company_id.sudo()"/>
                        </t>
                        <t t-else="else">
                            <t t-set="company" t-value="res_company"/>
                        </t>
                    </t>

                    <t t-if="not (env.context.get('proforma', False) or is_pro_forma)">
                        <t t-set="report_type" t-value="'sale'" />
                    </t>
                    <t t-if="env.context.get('proforma', False) or is_pro_forma">
                        <t t-set="report_type" t-value="'proforma'" />
                    </t>

                    <div class="page">
                        <div class="oe_structure"/>
                        <div class="row header_doc">
                            <div class="row col-12" style="margin-top: 75px;">
                                <div class="col-6">
                                    <span>Kepada Yth</span><br/>
                                    <span t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                                </div>
                            </div>
                        </div>
                        <style>
                            table, th, td {
                                border: 1px solid black !important;
                            }
                        </style>
                        <table style="margin-top: 50px;" class="table custom-table-bordered table-sm o_main_table">
                            <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                            <thead style="display: table-row-group; background-color: #0E709A; color: white;">
                                <tr>
                                    <th name="th_no" class="text-left">NO.</th>
                                    <th name="th_product" class="text-left">PRODUCT</th>
                                    <th name="th_label" class="text-left">LABEL</th>
                                    <th name="th_quantity" class="text-right">QTY</th>
                                    <th name="th_uom" class="text-right">UOM</th>
                                    <th name="th_price_unit" class="text-right">PRICE UNIT</th>
                                    <th name="th_tax" class="text-right">TAX</th>
                                    <th name="th_subtotal" class="text-right">SUBTOTAL</th>
                                </tr>
                            </thead>
                            <tbody class="sale_tbody">

                                <t t-set="index" t-value="0"/>

                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-set="index" t-value="index + 1"/>

                                    <tr class="bg-200 font-weight-bold o_line_section">
                                        <td name="td_no" class="text-left"><span t-esc="index" /></td>
                                        <td name="td_product" class="text-left"><span t-field="line.product_id" /></td>
                                        <td name="td_label" class="text-left"><span t-field="line.name" /></td>
                                        <td name="td_quantity" class="text-right"><span t-field="line.product_uom_qty" /></td>
                                        <td name="td_uom" class="text-right"><span t-field="line.product_uom" /></td>
                                        <td name="td_price_unit" class="text-right"><span t-field="line.price_unit"/></td>
                                        <td name="td_tax" class="text-right"><span t-esc="', '.join(map(lambda x: x.name, line.tax_id))"/></td>
                                        <td name="td_subtotal" class="text-right"><span t-field="line.price_subtotal"/></td>
                                    </tr>
                                </t>
                                <tr class="bg-200 font-weight-bold o_line_section">
                                    <td class="text-left" colspan="5" rowspan="3">Terbilang: <span t-field="doc.amount_terbilang"/></td>
                                    <td class="text-left" colspan="2">Untaxed Amount</td>
                                    <td class="text-right"><span t-field="doc.amount_untaxed"/></td>
                                </tr>
                                <tr class="bg-200 font-weight-bold">
                                    <td class="text-left" colspan="2">Taxes</td>
                                    <td class="text-right">
                                        <span t-field="doc.amount_tax"/>
                                    </td>
                                </tr>
                                <tr class="bg-200 font-weight-bold o_line_section">
                                    <td class="text-left" colspan="2">Amount</td>
                                    <td class="text-right"><span t-field="doc.amount_total"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-4 text-center">
                                <span>Hormat Kami,</span><br/>
                                <span t-field="company.name"/>
                                <div style="margin-top: 100px;">
                                    <span>Arianto Budiman</span><br/>
                                    <span>VP FTA</span>
                                </div>
                            </div>
                        </div>
                        <div class="row" t-if="report_type == 'proforma'">
                            <div class="col-6" style="border: 1px solid black;margin-top: 50px; padding: 10px">
                                <p>
                                    <p>Mohon pembayaran dapat dilakukan melalui transfer ke rekening:</p><br/>
                                    Bank Mandiri<br/>
                                    A.n PT. Bahana Bumi Mandiri<br/>
                                    No. Rek : 811 780 7866<br/>
                                </p>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
       </template>
    </data>
</odoo>