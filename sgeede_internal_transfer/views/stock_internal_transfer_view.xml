<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="stock_internal_transfer_tree" model="ir.ui.view">
		<field name="name">stock.internal.transfer.tree</field>
		<field name="model">stock.internal.transfer</field>
		<field name="arch" type="xml">
			<tree string="Stock Internal Transfer">
				<field name="name" select="1"/>
				<field name="date" select="1"/>
				<field name="source_warehouse_id" select="1"/>
				<field name="dest_warehouse_id" select="1"/>
				<field name="backorder_id" select="1"/>
				<field name="state" select="1"/>
			</tree>
		</field>
	</record>

	<record id="stock_internal_transfer_form" model="ir.ui.view">
		<field name="name">stock.internal.transfer.form</field>
		<field name="model">stock.internal.transfer</field>
		<field name="arch" type="xml">
			<form string="Stock Internal Transfer">
				<header>
					<button name="action_draft" type="object" invisible="1" class="oe_highlight" string="Set to Draft"/>
					<button name="action_confirm" type="object" states="draft" class="oe_highlight" string="Confirm"/>
					<button name="do_enter_wizard" type="object" states="confirm" class="oe_highlight" string="Send"/>
					<!-- <button name="action_receive" type="object" states="send" class="oe_highlight" string="Receive"/> -->
					<button name="do_enter_wizard" type="object" states="send" class="oe_highlight" string="Receive"/>
					<button name="action_cancel" type="object" states="confirm,send" string="Cancel"/>
					<field name="state" widget="statusbar" statusbar_visible="draft,confirm,send,done"/>
				</header>

				<sheet>
                    <div class="oe_title">
						<span class="o_form_label"> Internal Transfer </span>
						<h1>
							<field name="name" required="1" placeholder="Reference" readonly="1"/>
						</h1>
					</div>

					<group>
						<field name="company_id" required="1" attrs="{'readonly':[('state','!=','draft')]}"/>
						<field name="date" required="1" attrs="{'readonly':[('state','!=','draft')]}"/>
					</group>

					<group col="4">
						<field name="source_warehouse_id" required="1" attrs="{'readonly':[('state','!=','draft')]}"/>
						<field name="dest_warehouse_id" required="1" attrs="{'readonly':[('state','!=','draft')]}"/>
<!--						<field name="no_resi" attrs="{'readonly':[('state','!=','draft')]}"/>-->
<!--						<field name="eta_date" attrs="{'readonly':[('state','!=','draft')]}"/>-->
<!--						<field name="ekspedisi" attrs="{'readonly':[('state','!=','draft')]}"/>-->
<!--						<field name="ekspedisi" options="{'no_quick_create': True, 'no_create_edit' : True}"/> -->
					</group>

<!--					<group>-->
<!--						<group>-->
<!--							<field name="backorder_id" readonly="1"/>-->
<!--						</group>-->

<!--						<group>-->
<!--							<table width="100%">-->
<!--								<tr >-->
<!--									<td><label for="prepared_by"/></td>-->
<!--									<td><field name="prepared_by" options="{'no_open':True,'no_create': True}"/></td>-->
<!--									<td style="text-align:right"><field name="prepare_dt"/></td>-->
<!--								</tr>-->
<!--								<tr >-->
<!--									<td><label for="checked_by"/></td>-->
<!--									<td><field name="checked_by" options="{'no_open':True,'no_create': True}"/></td>-->
<!--									<td style="text-align:right"><field name="checked_dt"/></td>-->
<!--								</tr>-->
<!--								<tr >-->
<!--									<td><label for="driver_by"/></td>-->
<!--									<td><field name="driver_by" options="{'no_open':True,'no_create': True}"/></td>-->
<!--									<td style="text-align:right"><field name="driver_dt"/></td>-->
<!--								</tr>-->
<!--								<tr >-->
<!--									<td><label for="receiver_by"/></td>-->
<!--									<td><field name="receiver_by" options="{'no_open':True,'no_create': True}"/></td>-->
<!--									<td style="text-align:right"><field name="receiver_dt"/></td>-->
<!--								</tr>-->
<!--							</table>-->
<!--						</group>-->
<!--					</group>-->

					<notebook>
						<page string="Product">
							<field name="line_ids" nolabel="1" attrs="{'readonly':[('state','!=','draft')]}">
								<tree editable="bottom" string="lines" name='lines'>
									<field name="product_id" domain="[('type', '!=', 'service')]" required="1"/>
									<field name="product_qty" required="1"/>
									<field name="on_hand"/>
									<field name="product_uom_id" required="1"/>
<!--									<field name="product_sn"/>-->
									<field name="ket"/>
								</tree>
							</field>
						</page>

						<page string="Pickings">
							<field name="picking_ids" readonly="1" nolabel="1" attrs="{'readonly':[('state','!=','draft')]}"/>
						</page>
					</notebook>
					<field name="note"/>
				</sheet>

				<div class="oe_chatter" colspan="4">
					<field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
					<field name="message_ids" widget="mail_thread"/>
				</div>
			</form>
		</field>
	</record>

	<record id="action_stock_internal_transfer" model="ir.actions.act_window">
		<field name="name">Transfers Antar Gudang</field>
		<field name="res_model">stock.internal.transfer</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">tree,form</field>
	</record>

	<menuitem action="action_stock_internal_transfer" id="menu_stock_internal_transfer" parent="stock.menu_stock_warehouse_mgmt" sequence="1"/>


</odoo>