<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree" position="inside">
                <field name="purchase_request_lines" invisible="1" />
                <button
                    attrs="{'invisible': [('purchase_request_lines', '=', [])]}"
                    name="action_open_request_line_tree_view"
                    type="object"
                    icon="fa-folder-open-o"
                />
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='analytic_tag_ids']" position="replace">
                <field name="analytic_tag_id" optional="hide" groups="analytic.group_analytic_tags" domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
                <field name="analytic_tag_ids" invisible="1" groups="analytic.group_analytic_tags" widget="many2many_tags" options="{'color_field': 'color'}" domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
            </xpath>
            <!-- <xpath expr="//field[@name='order_line']/form/field[@name='analytic_tag_ids']" position="replace">
                <field name="analytic_tag_id" groups="analytic.group_analytic_tags" domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
                <field name="analytic_tag_ids" invisible="1" groups="analytic.group_analytic_tags" domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </xpath> -->
            <field name='partner_ref' position='after'>
                <field name='pr_id'/>
                <field name='priority_pr'/>
                <field name='no_rfq' attrs="{'invisible': [('state','in', ('draft','sent','to_approve'))]}"/>
                <field name='proc_group_id' attrs="{'readonly': [('state','not in', ('draft','po_draft'))]}"/>
                <field name='location' domain="[('tipe','=',1)]" attrs="{'readonly': [('state','not in', ('draft','po_draft'))]}" invisible="1"/>
<!--                <field name='cost_center'  attrs="{'readonly': [('state','not in', ('draft','po_draft'))]}"/>-->
            </field>
