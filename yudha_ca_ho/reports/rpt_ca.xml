        <record id="paperformat_cash_advance_ho_report" model="report.paperformat">
            <field name="name">Custom Paperformat for Cash Advance HO report</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <!-- this one is to make the pdf to become horizontal, if landscape=False, pdf will become vertical -->
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">8</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="dpi">96</field>
        </record>
        <record id="yudha_cash_advance_ho_report_view" model="ir.actions.report">
            <field name="name">Cash Advance</field>
            <field name="type">ir.actions.report</field>
            <field name="model">cash.advance.ho</field>
            <field name="report_name">yudha_ca_ho.ca_report</field>
            <field name="report_type">py3o</field>
            <field name="py3o_filetype">pdf</field>
            <field name="module">yudha_ca_ho</field>
            <field name="py3o_template_fallback">reports/CA.odt</field>
            <field name="binding_model_id" ref="yudha_ca_ho.model_cash_advance_ho" />
            <field name="binding_type">report</field>
             <field name="paperformat_id" ref="paperformat_cash_advance_ho_report"/>
            <field name="print_report_name">'Cash Advance - %s' % (object.name)</field>
        </record>
