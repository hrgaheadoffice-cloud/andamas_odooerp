<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="yudha_account_asset_maintenance_form" model="ir.ui.view">
        <field name="name">yudha account asset maintenance form</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
             <xpath expr="//button[@name='open_entries']" position='before'>
                <button type="object"  name="action_view_assets_maintenance"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o" attrs="{'invisible':[('assetmain_count', '=', 0)]}">
                    <field name="assetmain_count" widget="statinfo" string="Master Maintenance"/>
                    <field name='maintenance_ids' invisible="1"/>
                </button>
             </xpath>
            <xpath expr="//button[@name='validate']" position="before">
                <button name="buat_asset_maintenance" states="draft" string="Create Master Maintenance" type="object" class="oe_highlight"/>
            </xpath>
            <xpath expr="//field[@name='model_id']" position="after">
                <field name="kat_asset" options="{'no_create': True}"/>
                 <field name="purchase_date"/>
                 <field name="journal_asset_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>