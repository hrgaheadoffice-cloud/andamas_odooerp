<?xml version="1.0" encoding='UTF-8'?>
<odoo>
    <record id="view_picking_form_custom" model="ir.ui.view">
		<field name="name">view.picking.form.custom</field>
		<field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='description_picking']" position="replace">
                <field name="product_name" string="Product Name" optional="show"/>
                <field name="description_picking" string="Description" optional="show"/>
            </xpath>

             <xpath expr="//button[@name='action_assign']" position="after">
                <button name="action_create_purchase_request" class="oe_highlight" type="object" string="Create PR" attrs="{'invisible': [('show_check_availability', '=', False)]}"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_custom" model="ir.ui.view">
		<field name="name">view.stock.move.line.detailed.operation.tree</field>
		<field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_name" string="Product Name" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

