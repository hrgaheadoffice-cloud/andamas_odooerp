<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_payment_bisa_view" model="ir.ui.view">
            <field name="name">account_payment_bisa.form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">

                  <xpath expr="//field[@name='state']" position="before">
                    <button name="action_print" string="Print" type="object"/>
                  </xpath>
                  <xpath expr="//group/group[3]" position="after">
                      <group>
                        <field name="name" />
                        <field name="is_sundry" />
                        <field name="sundry_account_id" attrs="{'invisible': ['|',('is_sundry', '!=', True),('is_sundry_multi','=', True)]}"/>
                        <field name="is_sundry_multi" attrs="{'invisible': [('is_sundry', '!=', True)]}"  />
                        <field name="total_sundry" readonly = "1" force_save = "1" attrs="{'invisible': [('is_sundry_multi', '!=', True)]}"/>
                        <field name="sundry_multi_id" nolabel="1" attrs="{'invisible': [('is_sundry_multi', '!=', True)]}" >
                            <tree string="Kurir Laporan Invoice" editable="bottom" delete="true" create="true">
                                <field name="sundry_account_id"/>
<!--                                <field name="analytic_id"/>-->
<!--                                <field name="cost_center_id"/>-->
                                <field name="amount"/>
                            </tree>
                        </field>
                      </group>
                  </xpath>
<!--                <xpath expr="//field[@name='destination_account_id']" position="replace">-->
<!--                    <field name="destination_account_id" options="{'no_create': True}" attrs="{'invisible':[('is_sundry_multi','=', True)],'required':[('is_sundry_multi','!=', True)],'readonly': ['|', ('state', '!=', 'draft'), ('is_internal_transfer', '=', True)]}"/>-->
<!--                </xpath>-->
            </field>
         </record>
    </data>
</odoo>
