<odoo>
    <record id="view_tbl_batch_notif_po_form" model="ir.ui.view">
        <field name="name">tbl_batch_notif_po.form</field>
        <field name="model">tbl_batch_notif_po</field>
        <field name="arch" type="xml">
            <form string="Batch Notif PO">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                        </group>
                        <group>
                            <button string="Get Data" type="object" name="action_get_data"/>
                        </group>
                    </group>
                    <notebook>
                        <page>
                            <field name="line_ids"> 
                                <tree>
                                    <field name="date" />
                                    <field name="user_id"/>
                                    <field name="company_id" />
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="date" />
                                                <field name="user_id"/>
                                                <field name="company_id" />
                                            </group>
                                            <group>
                                                <button string="Send Email" type="object" name="action_send_email"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page>
                                                <field name="line_ids">
                                                    <tree editable="bottom">
                                                        <field name="po_line_id" />
                                                        <field name="date_start"/>
                                                        <field name="po_id" />
                                                        <field name="product_id" />
                                                        <field name="priority"/>
                                                        <field name="product_qty" />
                                                        <field name="product_uom_id"/>
                                                        <field name="estimated_price_unit" />
                                                        <field name="estimated_cost" />
                                                        <field name="company_id"/>
                                                        <field name="currency_id" />
                                                    </tree>
                                                </field>
                                            </page>
                                        </notebook>
                                        <field name="isi" widget="html" options="{'style-inline': true}"/>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_tbl_batch_notif_po_tree" model="ir.ui.view">
        <field name="name">tbl_batch_notif_po.tree</field>
        <field name="model">tbl_batch_notif_po</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
            </tree>
        </field>
    </record>
    <record model="ir.actions.act_window" id="tbl_batch_notif_po_form_action">
        <field name="name">Batch Notif</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tbl_batch_notif_po</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to start a new purchase request process.
            </p>
            <p>
                A purchase request is an instruction to Purchasing to procure
            a certain quantity of materials services, so that they are
            available at a certain point in time.
            </p>
        </field>
    </record>
    <!-- <menuitem
        id="menu_tbl_batch_notif_po_root"
        name="Notif"
        parent="parent_menu_purchase_request"
        sequence="100"
    />
    <menuitem
        id="menu_tbl_batch_notif_po"
        sequence="10"
        parent="menu_tbl_batch_notif_po_root"
        action="tbl_batch_notif_po_form_action"
    /> -->
</odoo>
