<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
        <record id="ir_cron_get_notif_po" model="ir.cron">
            <field name="name">Send Notif PO</field>
            <field name="model_id" ref="model_tbl_batch_notif_po"/>
            <field name="state">code</field>
            <field name="code">model.schedule_get_data()</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 22:00:00')" />
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="priority" eval="5" />
     </record>
  </data>
</odoo>