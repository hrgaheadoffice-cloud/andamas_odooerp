        <record id="email_template_notif_po" model="mail.template">
            <field name="name">Purchase Order: Notification by email</field>
            <field name="model_id" ref="purchase_order_approved.model_tbl_notif_po_user"/>
            <field name="subject">Purchase Order Approval needed on Odoo</field>
            <field name="email_from">"${object.company_id.name | safe}" &lt;${(object.company_id.email or user.email) | safe}&gt;</field>
            <field name="email_to">${object.user_id.partner_id.email| safe}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear ${object.user_id.partner_id.name | safe}, please give your approval on the purchase order submitted below:
                        <br/><br/>
                        <p>${object.isi | safe}</p>
                        <br/><br/>
                        <a href="${object.get_portal_url()}" style="background-color: #9E588B; margin-top: 10px; padding: 10px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;">View Purchase Order</a>
                        <br/><br/>
                        Odoo
                        <br/>
                    </p>
                </div>
            </field>
            <!-- <field name="report_template" ref="action_report_saleorder"/>
            <field name="report_name">${(object.name or '').replace('/','_')}</field> -->
            <field name="lang">${object.user_id.partner_id.lang}</field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
