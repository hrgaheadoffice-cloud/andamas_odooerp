<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <record id="smartmining_hyperlink_config_form_view" model="ir.ui.view">
           <field name="name">smartmining.hyperlink.config.form.view</field>
           <field name="model">res.config.settings</field>
           <field name="inherit_id" ref="base.res_config_settings_view_form"/>
           <field name="arch" type="xml">

                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div
                        class="app_settings_block"
                        data-string="Smart Mining"
                        string="Smart Mining"
                        data-key="smartmining_hyperlink"
                    >
                        <h2>Smart Mining</h2>
                        <div class="row mt16 o_settings_container" id="schedule">
                            <div class="col-xs-12 col-md-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <label
                                        for="smartmining_link"
                                        string="Smart Mining Link"
                                    />
                                    <div class="text-muted">
                                    </div>
                                    <field name="smartmining_link"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
           </field>
       </record>
    </data>
</odoo>