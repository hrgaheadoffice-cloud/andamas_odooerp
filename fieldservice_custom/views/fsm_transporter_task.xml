<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model='ir.ui.view' id='view_fsm_transporter_task_tree'>
        <field name="name">view.fsm.transporter.task.tree</field>
        <field name="model">fsm.transporter.task</field>
        <field name="arch" type="xml">
            <tree string="Transporter Task" js_class="maintenance_list_dashboard">
                <field name="date" string="Date &amp; Time Task"/>
                <field name="name"/>
                <field name="nip"/>
                <field name="driver_id"/>
                <field name="equipment_id"/>
                <field name="equipment_spare_id"/>
                <field name="transport_order_id"/>
                <field name="transporter_cost" string="Uang Jalan" sum="Total Uang Jalan"/>
                <field name="state" string="Status"/>
            </tree>
        </field>
    </record>

    <record id="view_transporter_task_search" model="ir.ui.view">
        <field name="model">fsm.transporter.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="transport_order_id"/>
                <field name="nip"/>
                <field name="equipment_id"/>
            </search>
        </field>
    </record>

    <record model='ir.ui.view' id='view_fsm_transporter_task_form'>
        <field name="name">view.fsm.transporter.task.form</field>
        <field name="model">fsm.transporter.task</field>
        <field name="arch" type="xml">
            <form string="Transporter Task">
                <header>
                    <button type="object" name="action_check" class="oe_highlight" string="Check" attrs="{'invisible': [('state', 'not in', ('draft'))]}"/>
                    <button type="object" name="action_confirm" class="oe_highlight" string="Confirm" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button type="object" name="action_loading" class="oe_highlight" string="Loading" attrs="{'invisible': [('state', '!=', 'confirm')]}"/>
                    <button type="object" name="action_create_delivery_order" class="oe_highlight" string="Create Delivery Order" attrs="{'invisible': ['|', ('delivery_order_id', '!=', False), ('state', '!=', 'loading')]}"/>
                    <button type="object" name="action_close" class="oe_highlight" string="Complete" attrs="{'invisible': [('state', '!=', 'loading')]}"/>
                    <button type="object" name="action_cancel_reason" string="Cancel" attrs="{'invisible': [('state', 'not in', ('confirm', 'loading'))]}"/>
<!--                    <button type="object" name="action_reject_reason" string="Reject" attrs="{'invisible': [('state', 'not in', ('confirm', 'loading'))]}"/>-->
                    <button type="object" name="action_draft" string="Set to Draft" attrs="{'invisible': [('state', 'not in', 'reject')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,loading,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label"> No. Task </span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <separator string="Main Info" colspan="4"/>
                            <field name="created_by"/>
                            <field name="date"/>
                            <field name="shift"/>
                            <field name="nip" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="driver_id" readonly="1" force_save="1"/>
                            <field name="equipment_id" readonly="1" force_save="1"/>
                            <field name="equipment_spare_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <separator string="Transporter Info" colspan="4"/>
                            <field name="transport_order_id" attrs="{'readonly': [('state', 'in', ('close', 'cancel'))]}"/>
                            <field name="transporter_cost_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="loading_location"/>
                            <field name="unloading_location"/>
                            <field name="transporter_cost" string="Uang Jalan"/>
                        </group>
                        <group>
                            <separator string="Additional Info" colspan="4"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="delivery_order_id" readonly="1"/>
                            <field name="transport_order_ids" widget="many2many_tags" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Extra Info">
                            <group>
                                <group>
                                    <field name="delivery_order_status" readonly="1" force_save="1"/>
                                    <field name="disciplinary_status" readonly="1" force_save="1"/>
                                    <field name="maintenance_status" readonly="1" force_save="1"/>
                                </group>
                                <group>
                                    <field name="cost_difference_policy" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                    <field name="residual_advance" readonly="1" force_save="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <!-- Action view for Vehicles Rent -->
    <record id="action_fsm_transporter_task_view" model="ir.actions.act_window">
        <field name="name">Transporter Task</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fsm.transporter.task</field>
    </record>

    <menuitem name="Transporter Task" id="menu_fsm_transporter_task" parent="fieldservice.operations" action="action_fsm_transporter_task_view" sequence="3"/>

    <record id="fsm_transporter_task_cancel_wizard" model="ir.ui.view">
        <field name="name">fsm.transporter.task.cancel.wizard</field>
        <field name="model">fsm.transporter.task</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form duplicate="0" delete="0" create="0">
                <group>
                    <field name="cancel_reason" required="1"/>
                </group>
                <footer>
                    <button name="action_cancel"  string="Confirm" class="btn-primary" type="object"/>
<!--                    <button string="" class="btn-secondary" special="cancel"/>-->
                </footer>
            </form>
        </field>
    </record>

    <record id="fsm_transporter_task_reject_wizard" model="ir.ui.view">
        <field name="name">fsm.transporter.task.reject.wizard</field>
        <field name="model">fsm.transporter.task</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form duplicate="0" delete="0" create="0">
                <group>
                    <field name="reject_reason" required="1"/>
                </group>
                <footer>
                    <button name="action_reject"  string="Confirm" class="btn-primary" type="object"/>
<!--                    <button string="" class="btn-secondary" special="cancel"/>-->
                </footer>
            </form>
        </field>
    </record>



   <record model="ir.actions.server" id="action_confirm_transporter_task">
       <field name="name">Confirm</field>
       <field name="model_id" ref="fieldservice_custom.model_fsm_transporter_task"/>
       <field name="binding_model_id" ref="fieldservice_custom.model_fsm_transporter_task"/>
       <field name="state">code</field>
       <field name="code">
           action = records.action_confirm()
       </field>
   </record>

   <record model="ir.actions.server" id="action_loading_transporter_task">
       <field name="name">Loading</field>
       <field name="model_id" ref="fieldservice_custom.model_fsm_transporter_task"/>
       <field name="binding_model_id" ref="fieldservice_custom.model_fsm_transporter_task"/>
       <field name="state">code</field>
       <field name="code">
           action = records.action_loading()
       </field>
   </record>

    <record model="ir.actions.server" id="action_close_transporter_task">
       <field name="name">Complete</field>
       <field name="model_id" ref="fieldservice_custom.model_fsm_transporter_task"/>
       <field name="binding_model_id" ref="fieldservice_custom.model_fsm_transporter_task"/>
       <field name="state">code</field>
       <field name="code">
           action = records.action_close()
       </field>
    </record>

    <record model="ir.actions.server" id="action_create_delivery_order">
       <field name="name">Create Delivery Order</field>
       <field name="model_id" ref="fieldservice_custom.model_fsm_transporter_task"/>
       <field name="binding_model_id" ref="fieldservice_custom.model_fsm_transporter_task"/>
       <field name="state">code</field>
       <field name="code">
           action = records.action_create_delivery_order_tree()
       </field>
    </record>
</odoo>
