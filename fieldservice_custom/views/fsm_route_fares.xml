<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model='ir.ui.view' id='view_fsm_route_fares_tree'>
        <field name="name">view.fsm.route_fares.tree</field>
        <field name="model">fsm.route.fares</field>
        <field name="arch" type="xml">
            <tree string="Route Fares">
                <field name="route_id"/>
                <field name="distance"/>
                <field name="freight_product"/>
                <field name="price_route"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record model='ir.ui.view' id='view_fsm_routes_form'>
        <field name="name">view.fsm.route.fares.form</field>
        <field name="model">fsm.route.fares</field>
        <field name="arch" type="xml">
            <form string="Route Fares">
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label"> Route Code </span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="transporter_type"/>
                        <field name="route_id"/>
                        <field name="loading_location"/>
                        <field name="unloading_location"/>
                        <field name="distance"/>
                        <field name="freight_product"/>
                        <field name="salary_route"/>
                        <field name="price_route"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action view for Vehicles Rent -->
    <record id="action_fsm_route_fares_view" model="ir.actions.act_window">
        <field name="name">Route Fares</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fsm.route.fares</field>
    </record>

    <menuitem name="Route Fares" id="menu_fsm_route_fares" parent="data" action="action_fsm_route_fares_view" sequence="40"/>
</odoo>
