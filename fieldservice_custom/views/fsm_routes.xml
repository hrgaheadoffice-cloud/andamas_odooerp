<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model='ir.ui.view' id='view_fsm_routes_tree'>
        <field name="name">view.fsm.routes.tree</field>
        <field name="model">fsm.routes</field>
        <field name="arch" type="xml">
            <tree string="Routes">
                <field name="name"/>
                <field name="loading_location"/>
                <field name="unloading_location"/>
                <field name="distance"/>
                <field name="duration"/>
            </tree>
        </field>
    </record>

    <record model='ir.ui.view' id='view_fsm_routes_form'>
        <field name="name">view.fsm.routes.form</field>
        <field name="model">fsm.routes</field>
        <field name="arch" type="xml">
            <form string="Routes">
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label"> Route Code </span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="loading_location"/>
                        <field name="unloading_location"/>
                        <field name="distance"/>
                        <field name="duration"/>
                        <field name="salary_route"/>
                        <field name="price_route"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>


    <!-- Action view for Vehicles Rent -->
    <record id="action_fsm_routes_view" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fsm.routes</field>
    </record>

    <menuitem name="Routes" id="menu_fsm_routes" parent="data" action="action_fsm_routes_view" sequence="40"/>
</odoo>
