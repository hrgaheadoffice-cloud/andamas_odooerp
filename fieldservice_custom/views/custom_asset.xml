<?xml version="1.0" encoding='UTF-8'?>
<odoo>
    <record id="inherit_master_asset_mt_form" model="ir.ui.view">
		<field name="name">form.inherit_master_asset_maintenance</field>
		<field name="model">master_asset_maintenance</field>
        <field name="inherit_id" ref="bisa_maintenance.master_asset_mt_form"/>
        <field name="arch" type="xml">
             <xpath expr="//page[1]" position="after">
                <page string="History Transporter">
							<field name="history_transporter_lines" readonly="1">
								<tree>
									<field name="date"/>
									<field name="nip"/>
									<field name="driver_id"/>
									<field name="transporter_cost_id"/>
									<field name="distance"/>
								</tree>
							</field>
						</page>
            </xpath>
        </field>
    </record>
</odoo>

