<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--My Dashboard-->
        <record model="ir.ui.view" id="board_maintenance_dash_view">
            <field name="name">board.maintenance.dash.view</field>
            <field name="model">board.board</field>
            <field name="arch" type="xml">
                <form string="Maintenance">
                    <board style="2-1">
                        <column>
                        </column>
                    </board>
                </form>
            </field>
        </record>

        <!--My Dashboard Action-->
        <record model="ir.actions.act_window" id="open_board_maintenance_action">
            <field name="name">Maintenance</field>
            <field name="res_model">board.board</field>
            <field name="view_mode">form</field>
            <field name="usage">menu</field>
            <field name="view_id" ref="board_my_dash_view"/>
        </record>
    </data>
    <data>

        <!--My Dashboard Menu-->
        <menuitem
            id="menu_board_maintenance_dash"
            parent="base.menu_board_root"
            action="open_board_my_dash_action"
            sequence="5"/>
    </data>
</odoo>
