<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
       <record id="fieldservice_custom_config_form_view" model="ir.ui.view">
           <field name="name">fieldservice.custom.config.form.view</field>
           <field name="model">res.config.settings</field>
           <field name="inherit_id" ref="fieldservice.res_config_settings_view_form"/>
           <field name="arch" type="xml">

                <xpath expr="//div[@id='mapping']" position="after">
                    <h2>Schedule</h2>
                    <div class="row mt16 o_settings_container" id="cost_advance">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label
                                    for="settlement_expense_account_id"
                                    string="Settlement Expense Account"
                                />
                                <div class="text-muted">
                                    Account that will be use in journal items from all settlement of cost advance.
                                </div>
                                <field name="settlement_expense_account_id"/>
                            </div>
                        </div>
                    </div>
                    <h2>Email notification when exceed due date</h2>
                    <div class="row mt16 o_settings_container" id="email_notification">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label
                                    for="email_transporter_task_exceed_24_hours"
                                    string="Email address after 24 hours"
                                />
                                <div class="text-muted">
                                    Send email to this addresses when transporter not finish after due date. Separated by comma.
                                </div>
                                <field name="email_transporter_task_exceed_24_hours"/>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label
                                    for="email_transporter_task_exceed_48_hours"
                                    string="Email address after 48 hours"
                                />
                                <div class="text-muted">
                                    Send email to this addresses when transporter not finish after due date. Separated by comma.
                                </div>
                                <field name="email_transporter_task_exceed_48_hours"/>
                            </div>
                        </div>
                    </div>
                </xpath>

           </field>
       </record>
    </data>
</odoo>