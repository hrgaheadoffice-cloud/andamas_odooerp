                            <td><field name="appr2" readonly="1"/></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right"><field name="appr2_dt"/></td>
                        </tr>
                        <tr>
                            <td><label for="appr3" string="Approved By"/></td>
                            <td></td>
                            <td></td>
                            <td><field name="appr3" readonly="1"/></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right"><field name="appr3_dt"/></td>
                        </tr>
                        <tr>
                            <td><label for="appr4" string="Approved By"/></td>
                            <td></td>
                            <td></td>
                            <td><field name="appr4" readonly="1"/></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right"><field name="appr4_dt"/></td>
                        </tr>
                        <tr>
                            <td><label for="appr5" string="Approved By"/></td>
                            <td></td>
                            <td></td>
                            <td><field name="appr5" readonly="1"/></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right"><field name="appr5_dt"/></td>
                        </tr>
                        <tr>
                            <td><label for="appr6" string="Approved By"/></td>
                            <td></td>
                            <td></td>
                            <td><field name="appr6" readonly="1"/></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right"><field name="appr6_dt"/></td>
                        </tr>
                        <tr>
                            <td><label for="appr7" string="Approved By"/></td>
                            <td></td>
                            <td></td>
                            <td><field name="appr7" readonly="1"/></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right"><field name="appr7_dt"/></td>
                        </tr>
                        <tr>
                            <td><label for="appr8" string="Approved By"/></td>
                            <td></td>
                            <td></td>
                            <td><field name="appr8" readonly="1"/></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right"><field name="appr8_dt"/></td>
                        </tr>
                    </table>
                </group>
            </group>
        </xpath>
    </field>
</record>
</odoo>