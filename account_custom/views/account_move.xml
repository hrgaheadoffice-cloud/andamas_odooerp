<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_custom" model="ir.ui.view">
        <field name="name">account.move.form.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_register_payment']" position='replace'>
                <button name="action_register_payment" id="account_invoice_payment_btn"
                        type="object" class="oe_highlight"
                        attrs="{'invisible': ['|', '|', ('state', '!=', 'posted'), ('payment_state', 'not in', ('not_paid', 'partial')), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"
                        context="{'dont_redirect_to_payments': True}"
                        string="Register Payment"
                        groups="account_custom.group_register_payment"/>
            </xpath>
        </field>
    </record>
    <record id="account_view_account_list" model="ir.ui.view">
        <field name="name">account.account.tree.custom</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_type_id']" position="after">
                <field name="grouping_dashboard" optional="hide"/>
            </xpath>
        </field>
    </record>
    	
</odoo>