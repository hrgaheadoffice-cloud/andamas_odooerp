<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="yudha_product_group_warehouse" model="ir.ui.view">
        <field name="name">yudha product group warehouse</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="warehouse_id" string="Warehouse"/>
                </field>
                <filter name="categ_id" position="after">
                        <filter string="Warehouse" name="group_warehouse_id" context="{'group_by':'warehouse_id'}"/>
                </filter>
        </field>
    </record>
    <record id="yudha_product_group_warehouse_tree" model="ir.ui.view">
        <field name="name">yudha product group warehouse tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="warehouse_id" invisible="1"/>
            </xpath>
        </field>
    </record>
    <record id="yudha_product_group_warehouse_form" model="ir.ui.view">
        <field name="name">yudha product group warehouse form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="warehouse_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>