        <!-- Inherit view from base module -->
        <record id="account_billing_approval" model="ir.ui.view">
            <field name="name">account.billing.approval</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Add or modify fields here -->
                        <xpath expr="//button[@name='action_post'][2]" position="replace">
                            <button string="Validate Tax" type="object" class="oe_highlight"
                                    name="tax_approve_act" groups="account_billing_approval.account_billing_tax_approve"
                                    attrs="{'invisible': ['|', '|','|', ('state', '!=', 'approve_requested'),('move_type', '=', 'entry'),
                                    ('move_type', 'in', ('out_invoice', 'out_refund')),('state', '=', 'cancel')]}"/>
                            <button string="Approve" type="object" class="oe_highlight"
                                    name="admin_approve_act" groups="account_billing_approval.account_billing_approve"
                                    attrs="{'invisible': ['|','|','|', ('state', '!=', 'tax_approved'),
                                    ('move_type', '=', 'admin_approve'),('move_type', 'in', ('out_invoice', 'out_refund')),
                                    ('state', '=', 'cancel')]}"/>
                            <button name="action_post" string="Confirm" class="oe_highlight" type="object" groups="account_billing_approval.account_billing_confirm"
                                    attrs="{'invisible': ['|', '|','|', ('state', '!=', 'admin_approved'), ('auto_post', '=', True), ('move_type', '=', 'entry'),
                                    ('move_type', 'in', ('out_invoice', 'out_refund'))]}"/>
                            <button name="submit_act" string="Submit" class="oe_highlight" type="object" groups="account_billing_approval.account_billing_confirm"
                                    attrs="{'invisible': ['|', '|','|', ('state', '!=', 'draft'), ('auto_post', '=', True), ('move_type', '=', 'entry'),('move_type', 'in', ('out_invoice', 'out_refund'))]}"/>

                            <!--Invoice Section-->
                            <button string="Validate Tax" type="object" class="oe_highlight"
                                    name="tax_approve_act" groups="account_billing_approval.account_invoice_tax_approve"
                                    attrs="{'invisible': ['|', '|','|', ('state', '!=', 'approve_requested'),('move_type', '=', 'entry'),('state', '=', 'cancel'),('move_type', 'in', ('in_invoice', 'in_refund'))]}"/>
                            <button string="Approve" type="object" class="oe_highlight"
                                    name="admin_approve_act" groups="account_billing_approval.account_invoice_approve"
                                    attrs="{'invisible': ['|','|','|', ('state', '!=', 'tax_approved'),('move_type', '=', 'admin_approve'), ('move_type', 'in', ('in_invoice', 'in_refund')),('state', '=', 'cancel')]}"/>
                            <button name="action_post" string="Confirm" class="oe_highlight" type="object" groups="account_billing_approval.account_invoice_confirm"
                                    attrs="{'invisible': ['|', '|','|', ('state', '!=', 'admin_approved'), ('auto_post', '=', True), ('move_type', '=', 'entry'), ('move_type', 'in', ('in_invoice', 'in_refund'))]}"/>
                            <button name="submit_act" string="Submit" class="oe_highlight" type="object" groups="account_billing_approval.account_invoice_confirm"
                                    attrs="{'invisible': ['|', '|','|', ('state', '!=', 'draft'), ('auto_post', '=', True), ('move_type', '=', 'entry'), ('move_type', 'in', ('in_invoice', 'in_refund'))]}"/>

                        </xpath>
                <xpath expr="//button[@name='button_cancel']" position="replace">
                    <button name="button_cancel" string="Cancel" type="object" groups="account_billing_approval.account_billing_cancel" attrs="{'invisible' : ['|','|','|', ('id', '=', True), ('state', '=', 'draft'),('state', '=', 'cancel'),('move_type', 'in', ('out_invoice', 'out_refund'))]}"/>
                    <button name="button_cancel" string="Cancel" type="object" groups="account_billing_approval.account_invoice_cancel" attrs="{'invisible' : ['|','|','|',('id', '=', False), ('state', '=', 'draft'),('state', '=', 'cancel'),('move_type', 'in', ('in_invoice', 'in_refund'))]}"/>
                </xpath>
<!--                <xpath expr="//button[@name='action_register_payment']" position="replace">-->
<!--                    <button name="action_register_to_payment" id="account_invoice_payment_btn" type="object" class="oe_highlight" attrs="{'invisible': ['|', '|', ('state', '!=', 'posted'),-->
<!--                            ('payment_state', 'not in', ('not_paid', 'partial')), ('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"-->
<!--                            context="{'dont_redirect_to_payments': True}" string="Register Payment" groups="account.group_account_invoice"/>-->
<!--                </xpath>-->
                <xpath expr="//field[@name='state']" position="replace">
                    <field name="state" widget="statusbar" statusbar_visible="draft,approve_requested,tax_approved,admin_approved,posted" attrs="{'invisible': [('move_type', '=', 'entry')]}"/>
                    <field name="state_a" widget="statusbar" statusbar_visible="draft,posted" attrs="{'invisible': [('move_type', '!=', 'entry')]}"/>
                </xpath>
                <xpath expr="//field[@name='payment_reference']" position="replace">
                </xpath>
                <xpath expr="//field[@name='partner_bank_id']" position="replace">
                </xpath>
                <xpath expr="//field[@name='invoice_vendor_bill_id']" position="replace">
                </xpath>
                <xpath expr="//label[@for='invoice_vendor_bill_id']" position="replace">
                </xpath>
            </field>
        </record>
    </data>
</odoo>
