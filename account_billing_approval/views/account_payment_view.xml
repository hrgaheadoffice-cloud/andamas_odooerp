<odoo>
    <record id="view_payment_form" model="ir.ui.view">
        <field name="name">view_payment_form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="state" position="replace">
                <field name="approval_stage" invisible="1"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,approved1,approved,posted" readonly="1" attrs="{'invisible': [('approval_stage', '&gt;', 1)]}"/>
                <field name="state_b" widget="statusbar" statusbar_visible="draft,approved1,approved2,approved,posted" readonly="1" attrs="{'invisible': [('approval_stage', '!=', 2)]}"/>
                <field name="state_c" widget="statusbar" statusbar_visible="draft,approved1,approved2,approved3,approved,posted" readonly="1" attrs="{'invisible': [('approval_stage', '!=', 3)]}"/>
                <field name="state_d" widget="statusbar" statusbar_visible="draft,approved1,approved2,approved3,approved4,approved,posted" readonly="1" attrs="{'invisible': [('approval_stage', '!=', 4)]}"/>
                <field name="state_e" widget="statusbar" statusbar_visible="draft,approved1,approved2,approved3,approved4,approved5,approved,posted" readonly="1" attrs="{'invisible': [('approval_stage', '!=', 5)]}"/>
            </field>
            <xpath expr="//button[@name='action_cancel']" position="replace">
                    <button name="action_cancel" string="Cancel" type="object" groups="account_billing_approval.account_payment_cancel" attrs="{'invisible' : ['|','|', ('id', '=', True),('state', '=', 'draft'),('state', '=', 'cancel')]}"/>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="replace">
                <button name="action_post" string="Confirm" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'approved')]}"/>
            </xpath>
            <button name="action_post" position="after">
                <button
                    name="button_appr1"
                    type="object"
                    states="approved1"
                    string="Approve"
                    class="oe_highlight"
                />
                <button
                    name="button_appr2"
                    type="object"
                    states="approved2"
                    string="Approve"
                    class="oe_highlight"
                />
                <button
                    name="button_appr3"
                    type="object"
                    states="approved3"
                    string="Approve"
                    class="oe_highlight"
                />
                <button
                    name="button_appr4"
                    type="object"
                    states="approved4"
                    string="Approve"
                    class="oe_highlight"
                />
                <button
                    name="button_appr5"
                    type="object"
                    states="approved5"
                    string="Approve"
                    class="oe_highlight"/>
                <button
                    name="button_to_approve"
                    type="object"
                    string="Request Approval"
                    class="oe_highlight"
                    attrs="{'invisible': [('state', '!=', 'draft')]}"
                />
            </button>
        </field>
    </record>
</odoo>
