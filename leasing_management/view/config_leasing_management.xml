<record id="lessor_leasing_management_tree" model="ir.ui.view">
    <field name="name">lessor.leasing.management.tree</field>
    <field name="model">lessor.leasing.management</field>
    <field name="arch" type="xml">
        <tree editable="bottom">
            <field name="name"/>
        </tree>
 </field>
</record>

