<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="view_lm_journal_voucher_form" model="ir.ui.view">
            <field name="name">lm.journal.voucher.form</field>
            <field name="model">lm.journal.voucher</field>
            <field name="arch" type="xml">
              <form class="o_sale_order" create="0" delete="0">
                <header>
                    <button name="button_approve" type="object" states='to approve' string="Approve" class="oe_highlight"/>
                    <button
                        name="button_approved_matrix"
                        states="to_approve_matrix"
                        string="Approve Matrix"
                        type="object"
                        class="oe_highlight"

                    />
                    <button
                            name="button_check"
                            string="Check"
                            type="object"
                            class="oe_highlight"
                            states="to_check"
                        />
                    <button
                            name="button_verify"
                            string="Verify"
                            type="object"
                            class="oe_highlight"
                            states="to_verify"
                        />

                    <button
                        name="button_reject"
                        string="Reject"
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible':[('state','in',['draft','approved','waiting_on_payment','rejected','done'])]}"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        states="rejected"
                        string="Set To Draft"
                        class="oe_highlight"
                    />
                    <button
                        name="button_request_approval"
                        type="object"
                        states="draft"
                        string="Request Approval"
                        class="oe_highlight"
                    />
                    <button name="register_payment" type="object"
                            string="Register Payment" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'waiting_on_payment')]}"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,waiting_on_payment,done,rejected" readonly="1"/>
                </header>
                <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="request_date" readonly="1"/>
                                <field name="journal_id" widget="selection" required="1" readonly="1"/>
                                <field name="request_amount" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="company_id" invisible="1"/>
                                <field name="warehouse_id" required="1" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                        <table>
                                        <tr >
                                            <td><label for="user_id" string="Prepared By"/></td>
                                            <td></td>
                                            <td></td>
                                            <td><field name="user_id" readonly="1"/></td>
                                            <td></td>
                                            <td></td>
                                            <td style="text-align:right"><field name="submit_dt" readonly="1"/></td>
                                        </tr>
                                        <tr>
                                            <td><label for="request_by" string="Requested By"/></td>
                                            <td></td>
                                            <td></td>
                                            <td><field name="request_by" attrs="{'readonly': [('state', 'not in', ('draft', 'done','rejected'))]}" required="1"/></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    </table>
                            </group>
                        </group>
                        <notebook>
                            <page string="Journal Voucher Details">
                                <field name="lm_journal_voucher_ids" readonly="1">
                                    <tree editable="bottom">
                                         <field name="currency_id" invisible="1"/>
                                         <field name="company_id" invisible="1"/>
                                         <field name="description"/>
                                         <field name="amount"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Journal Items" name="jurnal_ids">
                                <field name="acmove_ids" invisible="1"/>
                                <field name="jurnal_ids" readonly="1">
                                    <tree>
                                        <field name="account_id"/>
                                        <field name="name"/>
                                        <field name="debit"/>
                                        <field name="credit"/>
                                    </tree>
                                </field>
                            </page>
                            <!-- <page string="Approval Matrix">
                                <field name="approval_matrix_ids" readonly="1">
                                    <tree>
                                        <field name="state"/>
                                        <field name="user_ids" widget="many2many_tags"/>
                                        <field name="realization_user_id"/>
                                        <field name="date"/>
                                    </tree>
                                </field>
                            </page> -->
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="lm_journal_voucher_tree" model="ir.ui.view">
            <field name="name">lm.journal.voucher.tree</field>
            <field name="model">lm.journal.voucher</field>
            <field name="arch" type="xml">
                <tree create="0" delete="0">
                    <field name="name"/>
                    <field name="request_date"/>
                    <field name="request_by"/>
                    <field name="user_id"/>
                    <field name="request_bank"/>
                    <field name="request_amount"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="request_by"/>
                    <field name="checked_by"/>
                    <field name="payment_date"/>
                    <field name="payment_bank"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>
        <record id="view_lm_journal_voucher_filter" model="ir.ui.view">
            <field name="name">lm.journal.voucher.select</field>
            <field name="model">lm.journal.voucher</field>
            <field name="priority" eval="15"/>
            <field name="arch" type="xml">
                <search string="Search Journal Voucher">
                    <field name="name" string="Order" filter_domain="[('name', 'ilike', self)]"/>
                </search>
            </field>
        </record>

        <record id="action_lm_journal_voucher" model="ir.actions.act_window">
            <field name="name">Leasing Management Journal Voucher</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">lm.journal.voucher</field>
            <field name="search_view_id" ref="view_lm_journal_voucher_filter"/>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Report Leasing Management Journal Voucher
                </p>
                <p>
                    Create new Leasing Management Journal Voucher
                </p>
            </field>
        </record>
        <menuitem name="Journal Voucher" id="menu_lm_journal_voucher_top" parent="menu_leasing_management_root" action="action_lm_journal_voucher"  sequence="2"/>
    </data>
</odoo>