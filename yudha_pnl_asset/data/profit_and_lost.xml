<odoo>
    <data>
        <record id="rmb_financial_report_profitandloss0" model="account.financial.html.report">
            <field name="name">PROFIT AND LOSS</field>
            <field name="analytic" eval="True"/>
            <field name="unfold_all_filter" eval="True"/>
            <field name="show_journal_filter" eval="True"/>
            <field name='parent_id' ref='account.account_reports_legal_statements_menu'/>
        </record>
        <record id="rmb_report_sales_profit0" model="account.financial.html.report.line">
            <field name="name">SALES</field>
            <field name="code">SALS</field>
            <field name="parent_id" eval="False"/>
            <field name="financial_report_id" ref="rmb_financial_report_profitandloss0"/>
            <field name="domain" eval="[('account_id.sub_group','=',119)]"/>
            <field name="groupby">account_id</field>
            <field name="formulas">-sum</field>
            <field name="sequence" eval="1"/>
            <field name="level" eval="1" />
        </record>
        <record id="rmb_report_cogs_profit0" model="account.financial.html.report.line">
            <field name="name">COST OF GOODS SOLD</field>
            <field name="code">COSTOFGS</field>
            <field name="parent_id" eval="False"/>
            <field name="financial_report_id" ref="rmb_financial_report_profitandloss0"/>
            <field name="domain" eval="[('account_id.sub_group','=',120)]"/>
            <field name="groupby">account_id</field>
            <field name="formulas">sum</field>
            <field name="sequence" eval="2"/>
            <field name="level" eval="0" />
        </record>
        <record id="rmb_report_royalty_profit0" model="account.financial.html.report.line">
            <field name="name">Royalty</field>
            <field name="code">RYLT</field>
            <field name="parent_id" eval="False"/>
            <field name="financial_report_id" ref="rmb_financial_report_profitandloss0"/>
            <field name="domain" eval="[('account_id.sub_group','=',121)]"/>
            <field name="groupby">account_id</field>
            <field name="formulas">-sum</field>
            <field name="sequence" eval="3"/>
            <field name="level" eval="0" />
        </record>
        <record id="rmb_report_gross_profit0" model="account.financial.html.report.line">
            <field name="name">GROSS PROFIT</field>
            <field name="code">GRPFT</field>
            <field name="parent_id" eval="False"/>
            <field name="financial_report_id" ref="rmb_financial_report_profitandloss0"/>
            <field name="formulas">SALS + (COSTOFGS) + RYLT </field>
            <field name="sequence" eval="4"/>
            <field name="level" eval="0" />
        </record>
        <record id="rmd_report_general_administrative_expense" model="account.financial.html.report.line">
            <field name="name">General And Administrative Expense</field>
            <field name="code">GAAEXPEN</field>
            <field name="parent_id" eval="False"/>
            <field name="financial_report_id" ref="rmb_financial_report_profitandloss0"/>
