            <field name="name">PROFIT (LOSS) BEFORE TAX</field>
            <field name="code">PNLBT</field>
            <field name="parent_id" eval="False"/>
            <field name="financial_report_id" ref="rmb_financial_report_profitandloss0"/>
            <field name="formulas">GRPFT + GAAEXPEN +SALEX+ FRGNET + FINCOST + OINAENT</field>
            <field name="sequence" eval="11"/>
            <field name="level" eval="0" />
        </record>
