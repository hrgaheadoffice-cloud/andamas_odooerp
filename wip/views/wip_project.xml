<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <record id="wip_project_name_view_form" model="ir.ui.view">
        <field name="name">wip.project.view.form</field>
        <field name="model">wip.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_calory"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="term"/>
                            <field name="cargo_nomination"/>
                            <field name="contract_number"/>
<!--                            <field name="company_id" options="{'no_create': True}"/>-->
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="wip_project_view_tree" model="ir.ui.view">
        <field name="name">wip.project.view.tree</field>
        <field name="model">wip.project</field>
        <field name="arch" type="xml">
            <tree string="Project">
                <field name="name"/>
                <field name="product_calory"/>
                <field name="partner_id"/>
                <field name="term"/>
                <field name="cargo_nomination"/>
                <field name="contract_number"/>
<!--                <field name="company_id"/>-->
            </tree>
        </field>
    </record>


    <record id="wip_project_action" model="ir.actions.act_window">
        <field name="name">Project</field>
        <field name="res_model">wip.project</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>

    </record>

    <menuitem
        id="wip_project_menu"
        name="Project"
        parent="wip_management_root_menu"
        action="wip_project_action"
        sequence="20"/>
    </data>
</odoo>
