<odoo>
    <record model="ir.rule" id="cash_request_comp_rule">
        <field name="name">Purchase Request multi-company</field>
        <field name="model_id" ref="model_cash_request" />
        <field name="global" eval="True" />
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="category_cash_request" model="ir.module.category">
        <field name="name">Cash Request</field>
    </record>

    <record id="cash_request_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="category_cash_request"/>
    </record>
    <record id="cash_request_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="category_cash_request"/>
    </record>
    <record id="cash_request_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="category_id" ref="category_cash_request"/>
    </record>
    <record id="cash_request_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="category_cash_request"/>
    </record>
</odoo>