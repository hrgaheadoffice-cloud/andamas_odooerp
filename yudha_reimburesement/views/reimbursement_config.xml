<odoo>
    <data>
        <record id="view_reimbursement_config_form" model="ir.ui.view">
            <field name="name">reimbursement.config.form</field>
            <field name="model">reimbursement.config</field>
            <field name="arch" type="xml">
              <form string="reimbursement Config">
                <header>
                </header>
                <sheet>
                        <div class="oe_title">
                            <label for="is_default" string="Set Default"/>
                            <h1>
                                <field name="is_default"/>
                            </h1>
                        </div>
                        <group>
                            <group name="approval_finance" string="Finance Accounting Verification">
                                    <field name="approved_finance1" attrs="{'required': True}" options="{'no_create': True, 'no_open': True}" />
                                    <field name="approved_finance2" attrs="{'required': True}" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="approved_finance3" attrs="{'required': True}" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="approved_finance4" attrs="{'required': True}" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="approved_finance5" attrs="{'required': True}" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="approved_finance6" attrs="{'required': True}" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </group>
                </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_reimbursement_config_tree" model="ir.ui.view">
            <field name="name">reimbursement.config.tree</field>
            <field name="model">reimbursement.config</field>
            <field name="arch" type="xml">
                <tree string="reimbursement Config Tree">
                    <field name="is_default"/>
                    <field name="approved_finance1"/>
                    <field name="approved_finance2"/>
                    <field name="approved_finance3"/>
                    <field name="approved_finance4"/>
                    <field name="approved_finance5"/>
                    <field name="approved_finance6"/>

                </tree>
            </field>
        </record>
        <record id="view_reimbursement_config_filter" model="ir.ui.view">
            <field name="name">reimbursement.config.select</field>
            <field name="model">reimbursement.config</field>
            <field name="priority" eval="15"/>
            <field name="arch" type="xml">
                <search string="Search reimbursement">
                    <field name="is_default"/>
                    <field name="approved_finance1" />
                    <field name="approved_finance2"/>
                    <field name="approved_finance3"/>
                    <field name="approved_finance4"/>
                    <field name="approved_finance5"/>
                    <field name="approved_finance6"/>

                </search>
            </field>
        </record>

        <record id="action_reimbursement_config" model="ir.actions.act_window">
            <field name="name">Configuration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">reimbursement.config</field>
            <field name="search_view_id" ref="view_reimbursement_config_filter"/>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Report Configuration
                </p>
                <p>
                    Create new Configuration
                </p>
            </field>
        </record>
    </data>
</odoo>