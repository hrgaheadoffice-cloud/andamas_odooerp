<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Form View to Modify it -->

     <record id="yudha_pr_po_extended_form" model="ir.ui.view">
        <field name="name">yudha pr po extended line form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="before">
                 <field name="proc_group_id" invisible="1"/>
                 <field name="state" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form/group/group/field[@name='product_id']" position="before">
                 <field name="proc_group_id" invisible="1"/>
                 <field name="state" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>